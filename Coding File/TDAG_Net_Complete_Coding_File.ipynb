        "# ═══════════════════════════════════════════════════════════════════════════════\n",
        "# [21] GROUP 04 — EVENTS (Contribution 3 evidence)\n",
        "# ═══════════════════════════════════════════════════════════════════════════════\n",
        "\n",
        "@figure(\"F16\", \"Fig. 16. Station-Level Z-Score Peak Surge Scan\", \"04_event\")\n",
        "def fig_event_scan():\n",
        "    z = EVENTS[\"robust_z\"]\n",
        "    fig, axes = plt.subplots(1, 2, figsize=(13, 4), gridspec_kw={\"width_ratios\": [1.7, 1]})\n",
        "    ax = axes[0]\n",
        "    for di in range(N_DAYS):\n",
        "        ax.scatter([DAY_DATES[di]] * N_STATIONS, z[di],\n",
        "                   s=np.clip(3 + z[di] * 3, 3, 80),\n",
        "                   c=np.where(z[di] >= 4, ACCENT, \"#d2e3fc\"), alpha=0.7, lw=0)\n",
        "    ax.axhline(4, color=ACCENT, ls=\"--\", lw=1.0, label=\"z=4\")\n",
        "    ax.axhline(5, color=\"#7a1f00\", ls=\":\", lw=1.0, label=\"z=5\")\n",
        "    ax.xaxis.set_major_formatter(mdates.DateFormatter(\"%b %d\"))\n",
        "    ax.legend(loc=\"upper left\", fontsize=7)\n",
        "    _finish(ax, \"Station-day z-scores\", None, \"robust z-score\")\n",
        "    cand = EVENTS[\"candidates\"]\n",
        "    ax = axes[1]\n",
        "    if len(cand):\n",
        "        top = cand.head(15).iloc[::-1]\n",
        "        ax.barh(range(len(top)), top[\"surge_ratio\"], color=ACCENT, height=0.7)\n",
        "        ax.set_yticks(range(len(top)))\n",
        "        ax.set_yticklabels([f\"{r['date'][5:]} st{r['station_id']}\"\n",
        "                           for _, r in top.iterrows()], fontsize=6.5)\n",
        "        ax.axvline(1.0, color=MUTED, ls=\"--\", lw=0.7)\n",
        "        _finish(ax, \"Top surge candidates\", \"surge ratio\", None)\n",
        "    else:\n",
        "        ax.text(0.5, 0.5, \"no candidates\", ha=\"center\", va=\"center\")\n",
        "        ax.set_axis_off()\n",
        "    fig.autofmt_xdate()\n",
        "    _safe_tight(fig)\n",
        "    return fig, cand\n",
        "\n",
        "\n",
        "@figure(\"F17\", \"Fig. 17. Major Event Peak Anatomy & Persona Breakdown\", \"04_event\")\n",
        "def fig_event_anatomy():\n",
        "    cand = EVENTS[\"candidates\"]\n",
        "    if not len(cand):\n",
        "        return None, None\n",
        "    top = cand.iloc[0]\n",
        "    di = TENS[\"days\"].index(top[\"date\"])\n",
        "    ni = ST_POS[int(top[\"station_id\"])]\n",
        "    sl = slice(di * BINS_PER_DAY, (di + 1) * BINS_PER_DAY)\n",
        "    hours = HOUR_OF_BIN[:BINS_PER_DAY]\n",
        "\n",
        "    same_dow = np.where((DAY_DATES.dayofweek == DAY_DATES[di].dayofweek) &\n",
        "                        (np.arange(N_DAYS) != di))[0]\n",
        "    if len(same_dow) == 0:\n",
        "        same_dow = np.array([i for i in range(N_DAYS) if i != di])\n",
        "    base = X_total.reshape(N_DAYS, BINS_PER_DAY, N_STATIONS, 2)[same_dow][:, :, ni, :].sum(axis=2)\n",
        "    base_med = np.median(base, axis=0)\n",
        "    base_lo, base_hi = np.percentile(base, [10, 90], axis=0)\n",
        "    actual = X_total[sl, ni, :].sum(axis=1)\n",
        "\n",
        "    pers_day = X_persona[sl, ni, :, :].sum(axis=1)\n",
        "    pers_base = (X_persona.reshape(N_DAYS, BINS_PER_DAY, N_STATIONS, 2, K_PERSONA)\n",
        "                 [same_dow][:, :, ni, :, :].sum(axis=2).mean(axis=0))\n",
        "    excess = np.maximum(pers_day - pers_base, 0)\n",
        "    peak_win = slice(max(int(top[\"peak_bin\"]) - 6, 0), min(int(top[\"peak_bin\"]) + 7, BINS_PER_DAY))\n",
        "    attrib = excess[peak_win].sum(axis=0)\n",
        "    attrib_pct = 100 * attrib / max(attrib.sum(), 1e-9)\n",
        "\n",
        "    fig, axes = plt.subplots(1, 3, figsize=(14, 4.5),\n",
        "                             gridspec_kw={\"width_ratios\": [2.0, 1.1, 0.9], \"wspace\": 0.3})\n",
        "    ax = axes[0]\n",
        "    ax.fill_between(hours, base_lo, base_hi, color=MUTED, alpha=0.2, label=\"10-90th pct\")\n",
        "    ax.plot(hours, base_med, color=INK, lw=1.2, ls=\"--\", label=\"median\")\n",
        "    ax.plot(hours, actual, color=ACCENT, lw=2.0, label=f\"{top['date']}\")\n",
        "    ax.axvspan(hours[peak_win.start], hours[peak_win.stop-1], color=ACCENT, alpha=0.08)\n",
        "    ax.legend(loc=\"upper left\", fontsize=7)\n",
        "    _finish(ax, f\"Stn {int(top['station_id'])} surge x{top['surge_ratio']:.1f}\",\n",
        "            \"hour\", \"taps/10min\")\n",
        "    ax.set_xticks([6, 9, 12, 15, 18, 21])\n",
        "\n",
        "    ax = axes[1]\n",
        "    bottom = np.zeros(BINS_PER_DAY)\n",
        "    for k in range(K_PERSONA):\n",
        "        ax.fill_between(hours, bottom, bottom + excess[:, k], color=PERSONA_COLORS[k],\n",
        "                        alpha=0.8, label=_pname(k))\n",
        "        bottom += excess[:, k]\n",
        "    ax.legend(fontsize=6.5, loc=\"upper left\")\n",
        "    _finish(ax, \"Excess by persona\", \"hour\", \"excess taps/10min\")\n",
        "    ax.set_xticks([6, 9, 12, 15, 18, 21])\n",
        "\n",
        "    ax = axes[2]\n",
        "    ax.barh(range(K_PERSONA), attrib_pct, color=PERSONA_COLORS, height=0.6)\n",
        "    ax.set_yticks(range(K_PERSONA))\n",
        "    ax.set_yticklabels([_pname(k).split(\"/\")[0] for k in range(K_PERSONA)], fontsize=8)\n",
        "    ax.invert_yaxis()\n",
        "    for i, v in enumerate(attrib_pct):\n",
        "        ax.text(v + 0.8, i, f\"{v:.0f}%\", va=\"center\", fontsize=8, weight=\"bold\")\n",
        "    ax.set_xlim(0, max(attrib_pct.max() * 1.2, 10))\n",
        "    _finish(ax, \"Peak attribution\", \"% excess\", None)\n",
        "\n",
        "    _safe_tight(fig)\n",
        "    d = pd.DataFrame({\"hour\": hours, \"actual\": actual, \"baseline_median\": base_med,\n",
        "                      **{f\"excess_{_pname(k)}\": excess[:, k] for k in range(K_PERSONA)}})\n",
        "    return fig, d\n",
        "\n",
        "\n",
        "@figure(\"F18\", \"Fig. 18. Persona Mix & Dispersion: Event vs. Normal Days\", \"04_event\")\n",
        "def fig_event_vs_normal():\n",
        "    ev = np.array([d in set(EVENTS[\"event_days\"]) for d in TENS[\"days\"]])\n",
        "    if ev.sum() == 0 or (~ev).sum() == 0:\n",
        "        return None, None\n",
        "    P4 = X_persona.reshape(N_DAYS, BINS_PER_DAY, N_STATIONS, 2, K_PERSONA).sum(axis=(1, 2, 3))\n",
        "    ev_mix = P4[ev].mean(axis=0)\n",
        "    nm_mix = P4[~ev].mean(axis=0)\n",
        "    ev_pct = 100 * ev_mix / ev_mix.sum()\n",
        "    nm_pct = 100 * nm_mix / nm_mix.sum()\n",
        "\n",
        "    fig, axes = plt.subplots(1, 3, figsize=(13, 3.8))\n",
        "    w = 0.34\n",
        "    axes[0].bar(np.arange(K_PERSONA) - w/2, nm_pct, w, color=M3[\"blue100\"], label=\"normal\")\n",
        "    axes[0].bar(np.arange(K_PERSONA) + w/2, ev_pct, w, color=ACCENT, label=\"event\")\n",
        "    axes[0].set_xticks(range(K_PERSONA))\n",
        "    axes[0].set_xticklabels([_pname(k).split(\"/\")[0] for k in range(K_PERSONA)], fontsize=7.5)\n",
        "    axes[0].legend(fontsize=7)\n",
        "    _finish(axes[0], \"Persona mix\", None, \"% of daily volume\")\n",
        "\n",
        "    delta = ev_pct - nm_pct\n",
        "    axes[1].bar(range(K_PERSONA), delta, color=[PERSONA_COLORS[k] for k in range(K_PERSONA)],\n",
        "                width=0.6)\n",
        "    axes[1].axhline(0, color=INK, lw=0.7)\n",
        "    axes[1].set_xticks(range(K_PERSONA))\n",
        "    axes[1].set_xticklabels([_pname(k).split(\"/\")[0] for k in range(K_PERSONA)], fontsize=7.5)\n",
        "    _finish(axes[1], \"Event-day shift\", None, \"percentage points\")\n",
        "\n",
        "    peak = X_total.reshape(N_DAYS, BINS_PER_DAY, N_STATIONS, 2).sum(axis=3).max(axis=1)\n",
        "    bp = axes[2].boxplot([peak[~ev].max(axis=1), peak[ev].max(axis=1)], patch_artist=True,\n",
        "               boxprops=dict(facecolor=M3[\"blue100\"]), medianprops=dict(color=INK),\n",
        "               widths=0.5)\n",
        "    axes[2].set_xticks([1, 2])\n",
        "    axes[2].set_xticklabels([\"normal\", \"event\"], fontsize=8)\n",
        "    _finish(axes[2], \"Peak station load\", None, \"taps\")\n",
        "    _safe_tight(fig)\n",
        "    d = pd.DataFrame({\"persona\": [_pname(k) for k in range(K_PERSONA)],\n",
        "                      \"normal_pct\": nm_pct, \"event_pct\": ev_pct, \"delta_pp\": delta})\n",
        "    return fig, d\n",
        "\n",
        "\n",
        "@figure(\"F19\", \"Fig. 19. EC-AAM Venue Proximity Matrix C_venue Footprint\", \"04_event\")\n",
        "def fig_venue_footprint():\n",
        "    prox = C_VENUE.sum(axis=0) > 0\n",
        "    if prox.sum() == 0:\n",
        "        return None, None\n",
        "    ev = np.array([d in set(EVENTS[\"event_days\"]) for d in TENS[\"days\"]])\n",
        "    day_st = X_total.reshape(N_DAYS, BINS_PER_DAY, N_STATIONS, 2).sum(axis=(1, 3))\n",
        "    if ev.sum() and (~ev).sum():\n",
        "        ratio = day_st[ev].mean(axis=0) / np.maximum(day_st[~ev].mean(axis=0), 1.0)\n",
        "    else:\n",
        "        ratio = np.ones(N_STATIONS)\n",
        "    fig, axes = plt.subplots(1, 2, figsize=(13, 4), gridspec_kw={\"width_ratios\": [1.4, 1]})\n",
        "    order = np.argsort(-ratio)[:30]\n",
        "    axes[0].bar(range(len(order)), ratio[order],\n",
        "           color=[ACCENT if prox[i] else M3[\"blue100\"] for i in order], width=0.75)\n",
        "    axes[0].axhline(1.0, color=INK, lw=0.7)\n",
        "    axes[0].set_xticks(range(len(order)))\n",
        "    axes[0].set_xticklabels([str(int(STATION_IDS[i])) for i in order], rotation=90, fontsize=6.5)\n",
        "    axes[0].legend(handles=[Patch(color=ACCENT, label=\"venue-proximal\"),\n",
        "                            Patch(color=M3[\"blue100\"], label=\"other\")],\n",
        "                   loc=\"upper right\", fontsize=7)\n",
        "    _finish(axes[0], \"Event/normal volume ratio (top 30)\", \"station id\", \"ratio\")\n",
        "\n",
        "    axes[1].hist([ratio[prox], ratio[~prox]], bins=18, color=[ACCENT, M3[\"blue100\"]],\n",
        "            label=[\"proximal\", \"other\"], density=True)\n",
        "    axes[1].axvline(1.0, color=INK, lw=0.7)\n",
        "    axes[1].legend(fontsize=7)\n",
        "    _finish(axes[1], \"Ratio distribution\", \"event/normal ratio\", \"density\")\n",
        "    _safe_tight(fig)\n",
        "    d = pd.DataFrame({\"station_id\": STATION_IDS, \"venue_proximal\": prox, \"event_ratio\": ratio})\n",
        "    return fig, d\n",
        "\n",
        "\n",
        "@figure(\"F20\", \"Fig. 20. Exogenous Context Vector z_t Trajectories\", \"04_event\")\n",
        "def fig_exogenous():\n",
        "    n = min(BINS_PER_DAY * 14, T_STEPS)\n",
        "    d = pd.DataFrame(Z_GLOBAL[:n], columns=EXO[\"names\"])\n",
        "    d[\"t\"] = TIME_INDEX[:n]\n",
        "    show = [c for c in [\"tod_sin\", \"dow_cos\", \"is_weekend\", \"event_flag\", \"event_countdown\"]\n",
        "            if c in d.columns]\n",
        "    fig, axes = plt.subplots(len(show), 1, figsize=(13, 1.2 * len(show)), sharex=True)\n",
        "    axes = np.atleast_1d(axes)\n",
        "    for ax, c in zip(axes, show):\n",
        "        ax.plot(d[\"t\"], d[c], lw=1.0, color=M3[\"blue600\"])\n",
        "        ax.fill_between(d[\"t\"], 0, d[c], color=M3[\"blue600\"], alpha=0.12)\n",
        "        ax.set_ylabel(c, fontsize=7, rotation=0, ha=\"right\", va=\"center\")\n",
        "        ax.set_yticks([])\n",
        "    _finish(axes[0], \"Exogenous signal z_t\")\n",
        "    axes[-1].xaxis.set_major_formatter(mdates.DateFormatter(\"%b %d\"))\n",
        "    fig.autofmt_xdate()\n",
        "    _safe_tight(fig)\n",
        "    return fig, d\n"
      ]
