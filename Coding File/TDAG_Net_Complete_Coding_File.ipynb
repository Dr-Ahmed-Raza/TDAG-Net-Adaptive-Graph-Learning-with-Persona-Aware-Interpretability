      "source": [
        "# ═══════════════════════════════════════════════════════════════════════════════\n",
        "# [02] PROJECT SCAFFOLD + METADATA TEMPLATES\n",
        "# ═══════════════════════════════════════════════════════════════════════════════\n",
        "# Creates the folder tree and writes editable CSV templates for the *only* manual\n",
        "# data-collection task in the whole proposal: station coordinates + event venues +\n",
        "# event calendar. Nothing below blocks if you haven't filled them in yet — the\n",
        "# notebook falls back to fully data-driven substitutes and says so loudly.\n",
        "\n",
        "import json\n",
        "from pathlib import Path\n",
        "\n",
        "FIG_SUBDIRS = [\"01_corpus\", \"02_persona\", \"03_network\", \"04_event\", \"05_training\", \"06_results\"]\n",
        "\n",
        "for _k, _v in P.items():\n",
        "    Path(_v).mkdir(parents=True, exist_ok=True)\n",
        "for _sub in FIG_SUBDIRS:\n",
        "    Path(f\"{P['figures']}/{_sub}\").mkdir(parents=True, exist_ok=True)\n",
        "\n",
        "# ── Template 1: station metadata (names + coordinates) ───────────────────────\n",
        "_station_tpl = f\"{P['meta']}/station_metadata.csv\"\n",
        "if not os.path.exists(_station_tpl):\n",
        "    pd.DataFrame(\n",
        "        columns=[\"station_id\", \"station_name_cn\", \"station_name_en\",\n",
        "                 \"latitude\", \"longitude\", \"line_primary\", \"is_interchange\", \"station_class\"]\n",
        "    ).to_csv(_station_tpl, index=False)\n",
        "\n",
        "# ── Template 2: event venues (the ~10 you actually need) ─────────────────────\n",
        "_venue_tpl = f\"{P['meta']}/event_venues.csv\"\n",
