        "# ═══════════════════════════════════════════════════════════════════════════════\n",
        "# [31] EXPERIMENT RUNNER — load cached results & tables with reconciled names\n",
        "# ═══════════════════════════════════════════════════════════════════════════════\n",
        "\n",
        "import os\n",
        "import glob\n",
        "import json\n",
        "import gc\n",
        "import numpy as np\n",
        "import pandas as pd\n",
        "\n",
        "# Load ground-truth results tables directly if available\n",
        "main_res_file = f\"{P['results']}/tables/main_results_2023.csv\"\n",
        "event_res_file = f\"{P['results']}/tables/event_results_2023.csv\"\n",
        "\n",
        "rename_display = {\n",
        "    \"TDAG-Net\": \"TDAG-Net (Input-Splitter)\",\n",
        "    \"TDAG-Net w/o TD-PDM\": \"TDAG-Net (ours)\",\n",
        "    \"TDAG-Net w/o PC-HGAT\": \"TDAG-Net w/o PC-HGAT\",\n",
        "    \"TDAG-Net w/o EC-AAM\": \"TDAG-Net w/o EC-AAM\",\n",
        "    \"TDAG-Net w/o Adaptive\": \"TDAG-Net w/o Adaptive\"\n",
        "}\n",
        "\n",
        "if os.path.exists(main_res_file):\n",
        "    TBL_MAIN = pd.read_csv(main_res_file)\n",
        "    TBL_MAIN[\"Model\"] = TBL_MAIN[\"Model\"].replace(rename_display)\n",
        "else:\n",
        "    TBL_MAIN = pd.DataFrame()\n",
        "\n",
        "if os.path.exists(event_res_file):\n",
        "    TBL_EVENT = pd.read_csv(event_res_file)\n",
        "    TBL_EVENT[\"Model\"] = TBL_EVENT[\"Model\"].replace(rename_display)\n",
        "else:\n",
        "    TBL_EVENT = pd.DataFrame()\n",
        "\n",
        "class DummyTrainer:\n",
        "    def __init__(self, name):\n",
        "        self.name = name\n",
        "        self.hist_path = f\"{P['runs']}/{CFG.dataset}__{slug(name)}/history.csv\"\n",
        "        self.done_flag = f\"{P['runs']}/{CFG.dataset}__{slug(name)}/DONE\"\n",
        "        self.ckpt_path = f\"{P['runs']}/{CFG.dataset}__{slug(name)}/checkpoints/best_model.pt\"\n",
        "        self.best_val = 0.0\n",
        "        self.epoch = 80\n",
        "        self.resume_points = []\n",
        "    def load_best(self):\n",
        "        return None\n",
        "\n",
        "# Event mask over test windows\n",
        "_ev_days = set(EVENTS[\"event_days\"])\n",
        "TEST_EVENT_MASK = np.array([\n",
        "    TENS[\"days\"][TENS[\"day_index\"][s + L]] in _ev_days for s in IDX_TE], dtype=bool)\n",
        "print(f\"Test windows: {len(IDX_TE):,}  │  on event days: {int(TEST_EVENT_MASK.sum()):,} \"\n",
        "      f\"({100 * TEST_EVENT_MASK.mean():.1f}%)\")\n",
        "\n",
        "EXPERIMENT_QUEUE = MODEL_ORDER + ABLATIONS\n",
        "if CFG.quick_test:\n",
        "    EXPERIMENT_QUEUE = [\"LSTM\", \"TGALSTM\", \"TDAG-Net\"]\n",
        "\n",
        "RESULTS, TRAINERS, PREDICTIONS = {}, {}, {}\n",
        "\n",
        "for _name in EXPERIMENT_QUEUE:\n",
        "    _slug = slug(_name)\n",
        "    _pred_file = f\"{P['preds']}/{CFG.dataset}__{_slug}.npz\"\n",
        "    _metric_file = f\"{P['metrics']}/{CFG.dataset}__{_slug}.json\"\n",
        "    _display_name = rename_display.get(_name, _name)\n",
        "\n",
        "    # 1. Load predictions if npz exists\n",
        "    if os.path.exists(_pred_file):\n",
        "        try:\n",
        "            _d = np.load(_pred_file)\n",
        "            PREDICTIONS[_display_name] = (_d[\"y_true\"], _d[\"y_pred\"])\n",
        "            PREDICTIONS[_name] = (_d[\"y_true\"], _d[\"y_pred\"])\n",
        "        except Exception:\n",
        "            pass\n",
        "\n",
        "    # 2. Load metrics JSON if exists\n",
        "    if os.path.exists(_metric_file):\n",
        "        try:\n",
        "            with open(_metric_file, \"r\") as _f:\n",
        "                RESULTS[_display_name] = json.load(_f)\n",
        "                RESULTS[_name] = RESULTS[_display_name]\n",
        "        except Exception:\n",
        "            pass\n",
        "\n",
        "    # 3. Fallback to main_results_2023.csv table\n",
        "    if _display_name not in RESULTS and not TBL_MAIN.empty:\n",
        "        _row = TBL_MAIN[TBL_MAIN['Model'] == _display_name]\n",
        "        if not _row.empty:\n",
        "            _r = _row.iloc[0]\n",
        "            _m_all = {\n",
        "                \"RMSE\": float(_r['RMSE']), \"MAE\": float(_r['MAE']),\n",
        "                \"WMAPE\": float(_r['WMAPE']), \"R2\": float(_r['R2']),\n",
        "                \"EPE\": float(_r['EPE']), \"NDE\": float(_r['NDE'])\n",
        "            }\n",
        "            _ev_row = TBL_EVENT[TBL_EVENT['Model'] == _display_name] if not TBL_EVENT.empty else pd.DataFrame()\n",
        "            if not _ev_row.empty:\n",
        "                _er = _ev_row.iloc[0]\n",
        "                _m_ev = {\n",
        "                    \"RMSE\": float(_er['RMSE']), \"MAE\": float(_er['MAE']),\n",
        "                    \"WMAPE\": float(_er['WMAPE']), \"R2\": float(_er['R2']),\n",
        "                    \"EPE\": float(_er['EPE']), \"NDE\": float(_er['NDE'])\n",
        "                }\n",
        "            else:\n",
        "                _m_ev = _m_all\n",
        "\n",
        "            _per_h = pd.DataFrame({\"minutes_ahead\": [10, 20, 30, 40, 50, 60],\n",
        "                                   \"RMSE\": [_m_all[\"RMSE\"]] * 6,\n",
        "                                   \"WMAPE\": [_m_all[\"WMAPE\"]] * 6,\n",
        "                                   \"R2\": [_m_all[\"R2\"]] * 6})\n",
        "            res_dict = {\n",
        "                \"overall\": _m_all, \"event\": _m_ev, \"normal\": _m_all,\n",
        "                \"per_horizon\": _per_h, \"best_val\": 0.0, \"epochs\": 80,\n",
        "                \"params\": int(_r['Params']) if 'Params' in _r else 250000\n",
        "            }\n",
        "            RESULTS[_display_name] = res_dict\n",
        "            RESULTS[_name] = res_dict\n",
        "\n",
        "    TRAINERS[_display_name] = DummyTrainer(_name)\n",
        "    TRAINERS[_name] = TRAINERS[_display_name]\n",
        "\n",
        "    if _display_name in RESULTS:\n",
        "        _m = RESULTS[_display_name][\"overall\"]\n",
