        "        columns=[\"date\", \"venue_id\", \"event_type\", \"start_time\", \"end_time\",\n",
        "                 \"expected_attendance\", \"source\", \"verified\"]\n",
        "    ).to_csv(_event_tpl, index=False)\n",
        "\n",
        "# ── Template 4: weather (optional; no-op if left empty) ──────────────────────\n",
