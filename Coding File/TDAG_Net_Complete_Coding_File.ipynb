      "source": [
        "Implements the sliding-window generator and deterministic mini-batcher with support for exact state resume."
      ]
    },
    {
      "cell_type": "code",
      "execution_count": 30,
      "id": "63229231",
      "metadata": {
        "id": "63229231"
      },
      "outputs": [],
      "source": [
        "# ═══════════════════════════════════════════════════════════════════════════════\n",
        "# [24] TDAG-NET COMPONENTS\n",
        "# ═══════════════════════════════════════════════════════════════════════════════\n",
        "\n",
        "class ChannelAttention(nn.Module):\n",
        "    \"\"\"TGALSTM Fig. 4: avg-pool ⊕ max-pool → MLP → sigmoid → per-channel gain.\"\"\"\n",
        "\n",
        "    def __init__(self, ch, r=4):\n",
        "        super().__init__()\n",
        "        self.mlp = nn.Sequential(nn.Linear(ch, max(ch // r, 4)), nn.ReLU(),\n",
        "                                 nn.Linear(max(ch // r, 4), ch))\n",
        "\n",
        "    def forward(self, x):                       # x: [B, C, L]\n",
        "        a = self.mlp(x.mean(dim=-1))\n",
        "        m = self.mlp(x.amax(dim=-1))\n",
        "        return x * torch.sigmoid(a + m).unsqueeze(-1)\n",
        "\n",
        "\n",
        "class EnhancedTCN(nn.Module):\n",
        "    \"\"\"\n",
        "    TGALSTM's improved TCN, kept faithful:\n",
        "      three parallel dilated causal convolutions (neighbouring / daily / weekly cycles)\n",
        "      → local sigmoid gate → ReLU → channel attention → 1×1 residual.\n",
        "    \"\"\"\n",
        "\n",
        "    def __init__(self, c_in, c_out, dilations=(1, 2, 4, 8), k=3, dropout=0.1):\n",
        "        super().__init__()\n",
        "        self.dils = list(dilations)[:3] if len(dilations) >= 3 else list(dilations)\n",
        "        self.k = k\n",
        "        self.convs = nn.ModuleList([nn.Conv1d(c_in, c_out, k, dilation=d) for d in self.dils])\n",
        "        self.gate = nn.Conv1d(c_in, c_out, k, dilation=self.dils[min(1, len(self.dils) - 1)])\n",
        "        self.catt = ChannelAttention(c_out)\n",
        "        self.res = nn.Conv1d(c_in, c_out, 1)\n",
        "        self.norm = nn.BatchNorm1d(c_out)\n",
        "        self.drop = nn.Dropout(dropout)\n",
        "\n",
        "    def _causal(self, conv, x):\n",
        "        pad = (self.k - 1) * conv.dilation[0]\n",
        "        return conv(Fn.pad(x, (pad, 0)))\n",
        "\n",
        "    def forward(self, x):                       # x: [B, C_in, L]\n",
        "        outs = [self._causal(c, x) for c in self.convs]\n",
        "        g = torch.sigmoid(self._causal(self.gate, x))\n",
        "        outs[min(1, len(outs) - 1)] = outs[min(1, len(outs) - 1)] * g\n",
        "        h = Fn.relu(sum(outs))\n",
        "        h = self.catt(h)\n",
        "        h = self.norm(h)\n",
        "        return self.drop(h) + self.res(x)\n",
        "\n",
        "\n",
        "class TDPDM(nn.Module):\n",
        "    \"\"\"\n",
        "    ① Ticket-Persona Disaggregation Module.\n",
        "    Learnable soft assignment P ∈ ℝ^{C×K} (initialised from the behavioural prior) and a\n",
        "    learnable per-persona event-volatility weight α_k.\n",
        "    \"\"\"\n",
        "\n",
        "    def __init__(self, n_card, K, prior=None, tau=1.0):\n",
        "        super().__init__()\n",
        "        init = torch.log(torch.clamp(prior, 1e-4)) if prior is not None else torch.zeros(n_card, K)\n",
        "        self.logits = nn.Parameter(init.clone())\n",
        "        self.alpha = nn.Parameter(torch.zeros(K))\n",
        "        self.tau = tau\n",
        "        self.register_buffer(\"prior\", prior.clone() if prior is not None\n",
        "                             else torch.full((n_card, K), 1.0 / K))\n",
        "\n",
        "    def assignment(self):\n",
        "        return torch.softmax(self.logits / self.tau, dim=-1)          # [C, K]\n",
        "\n",
        "    def forward(self, x_card, event):\n",
        "        # x_card [B,L,N,2,C] · event [B,L] → [B,L,N,2,K]\n",
        "        P = self.assignment()\n",
        "        xp = torch.einsum(\"blndc,ck->blndk\", x_card, P)\n",
        "        gain = 1.0 + Fn.softplus(self.alpha).view(1, 1, 1, 1, -1) * event.view(*event.shape, 1, 1, 1)\n",
        "        return xp * gain, P\n",
        "\n",
        "    def aux_loss(self):\n",
        "        P = self.assignment()\n",
        "        kl = (P * (torch.log(P + 1e-8) - torch.log(self.prior + 1e-8))).sum(-1).mean()\n",
        "        ent = -(P * torch.log(P + 1e-8)).sum(-1).mean()                # discourage mush\n",
        "        return kl, ent\n",
        "\n",
        "\n",
        "class DenseGAT(nn.Module):\n",
        "    \"\"\"Multi-head graph attention over a dense (masked) adjacency — N≈191 so dense is cheap.\"\"\"\n",
        "\n",
        "    def __init__(self, d_in, d_out, heads=4, dropout=0.1, concat=True):\n",
        "        super().__init__()\n",
        "        self.h, self.dk = heads, d_out // heads if concat else d_out\n",
        "        self.concat = concat\n",
        "        self.W = nn.Linear(d_in, self.h * self.dk, bias=False)\n",
        "        self.a_src = nn.Parameter(torch.empty(1, self.h, 1, self.dk))\n",
        "        self.a_dst = nn.Parameter(torch.empty(1, self.h, 1, self.dk))\n",
        "        nn.init.xavier_uniform_(self.a_src)\n",
        "        nn.init.xavier_uniform_(self.a_dst)\n",
        "        self.drop = nn.Dropout(dropout)\n",
        "\n",
        "    def attention(self, h_pool, adj):\n",
        "        # h_pool [B,N,d_in] · adj [B,N,N] (or [N,N]) → attn [B,h,N,N]\n",
        "        B, N, _ = h_pool.shape\n",
        "        Wh = self.W(h_pool).view(B, N, self.h, self.dk).permute(0, 2, 1, 3)     # [B,h,N,dk]\n",
        "        e = ((Wh * self.a_src).sum(-1).unsqueeze(-1) +\n",
        "             (Wh * self.a_dst).sum(-1).unsqueeze(-2))                            # [B,h,N,N]\n",
        "        e = Fn.leaky_relu(e, 0.2)\n",
        "        if adj.dim() == 2:\n",
        "            adj = adj.unsqueeze(0).expand(B, -1, -1)\n",
        "        eye = torch.eye(N, device=adj.device, dtype=torch.bool).unsqueeze(0)\n",
        "        mask = ((adj.abs() > 0) | eye).unsqueeze(1)      # self-loop keeps every row valid\n",
        "        e = e.masked_fill(~mask, -9e15)\n",
        "        att = torch.softmax(e, dim=-1)\n",
        "        att = torch.nan_to_num(att, nan=0.0)\n",
        "        return self.drop(att), Wh\n",
        "\n",
        "    def forward(self, h_seq, h_pool, adj):\n",
        "        # h_seq [B,L,N,d_in] → [B,L,N,d_out] using attention derived from h_pool\n",
        "        att, _ = self.attention(h_pool, adj)                                     # [B,h,N,N]\n",
        "        B, Lx, N, _ = h_seq.shape\n",
        "        Wh = self.W(h_seq).view(B, Lx, N, self.h, self.dk)\n",
        "        out = torch.einsum(\"bhij,bljhd->blihd\", att, Wh)\n",
        "        out = out.reshape(B, Lx, N, self.h * self.dk) if self.concat else out.mean(-2)\n",
        "        return Fn.elu(out), att\n",
        "\n",
        "\n",
        "class AdaptiveAdjacency(nn.Module):\n",
        "    \"\"\"Graph WaveNet-style learned adjacency (Wu et al., IJCAI 2019), seeded per persona.\"\"\"\n",
        "\n",
        "    def __init__(self, n_nodes, emb=16, init_adj=None):\n",
        "        super().__init__()\n",
        "        self.E1 = nn.Parameter(torch.randn(n_nodes, emb) * 0.05)\n",
        "        self.E2 = nn.Parameter(torch.randn(n_nodes, emb) * 0.05)\n",
        "        self.mix = nn.Parameter(torch.tensor(0.5))\n",
        "        A0 = init_adj if init_adj is not None else torch.eye(n_nodes)\n",
        "        if float(A0.abs().sum()) == 0.0:\n",
        "            A0 = torch.eye(n_nodes)\n",
        "        self.register_buffer(\"A0\", A0.clone())\n",
        "\n",
        "    def forward(self, enabled=True):\n",
        "        A0 = self.A0.abs()\n",
        "        if not enabled:\n",
        "            return A0 / A0.sum(-1, keepdim=True).clamp(min=1e-6)\n",
        "        Aad = Fn.softmax(Fn.relu(self.E1 @ self.E2.t()), dim=-1)\n",
        "        w = torch.sigmoid(self.mix)\n",
        "        A = w * Aad + (1 - w) * A0 / A0.sum(-1, keepdim=True).clamp(min=1e-6)\n",
        "        return A\n",
        "\n",
        "\n",
        "class ECAAM(nn.Module):\n",
        "    \"\"\"\n",
        "    ④ Event-Conditional Adaptive Adjacency.\n",
        "    During an active event window the venue footprint M_venue is added to the persona\n",
        "    adjacency with a *learnable per-persona strength* γ_k — so the model can discover for\n",
        "    itself that (as the proposal hypothesises) the tourist/casual graph reacts most.\n",
        "    \"\"\"\n",
        "\n",
        "    def __init__(self, K, dz):\n",
        "        super().__init__()\n",
        "        self.gamma = nn.Parameter(torch.full((K,), 0.5))\n",
        "        self.gate = nn.Sequential(nn.Linear(dz, 16), nn.ReLU(), nn.Linear(16, 1))\n",
        "\n",
        "    def forward(self, A_k, z_last, M_venue, enabled=True):\n",
        "        # A_k [K,N,N] · z_last [B,dz] · M_venue [N,N] → [B,K,N,N]\n",
        "        B = z_last.shape[0]\n",
        "        A = A_k.unsqueeze(0).expand(B, -1, -1, -1)\n",
        "        if not enabled:\n",
        "            return A, torch.zeros(B, 1, device=z_last.device)\n",
        "        g = torch.sigmoid(self.gate(z_last))                                # [B,1]\n",
        "        add = (g.view(B, 1, 1, 1) *\n",
        "               Fn.softplus(self.gamma).view(1, -1, 1, 1) *\n",
        "               M_venue.view(1, 1, *M_venue.shape))\n",
        "        A = A + add\n",
        "        A = A / A.sum(-1, keepdim=True).clamp(min=1e-6)\n",
        "        return A, g\n",
        "\n",
        "\n",
        "class PCHGAT(nn.Module):\n",
        "    \"\"\"③ Persona-Conditioned Heterogeneous GAT: K adaptive views + cross-persona fusion β_k(z_t).\"\"\"\n",
        "\n",
        "    def __init__(self, d_in, d_out, K, n_nodes, dz, heads=4, emb=16, init_adj=None, dropout=0.1):\n",
        "        super().__init__()\n",
        "        self.K = K\n",
        "        self.adapt = nn.ModuleList([\n",
        "            AdaptiveAdjacency(n_nodes, emb, None if init_adj is None else init_adj[k])\n",
        "            for k in range(K)])\n",
        "        self.gats = nn.ModuleList([DenseGAT(d_in, d_out, heads, dropout) for _ in range(K)])\n",
        "        self.ecaam = ECAAM(K, dz)\n",
        "        self.beta = nn.Sequential(nn.Linear(dz, 32), nn.ReLU(), nn.Linear(32, K))\n",
        "\n",
        "    def forward(self, h, z_last, M_venue, use_adaptive=True, use_ecaam=True, share_adj=False):\n",
        "        # h [B,L,N,K,d_in] → [B,L,N,d_out]\n",
        "        B, Lx, N, K, _ = h.shape\n",
        "        A_k = torch.stack([self.adapt[k](enabled=use_adaptive)\n",
        "                           for k in range(K)])                              # [K,N,N]\n",
        "        if share_adj:\n",
        "            A_k = A_k.mean(0, keepdim=True).expand(K, -1, -1)\n",
        "        A_b, gate = self.ecaam(A_k, z_last, M_venue, enabled=use_ecaam)      # [B,K,N,N]\n",
        "\n",
        "        outs, atts = [], []\n",
        "        for k in range(K):\n",
        "            hk = h[:, :, :, k, :]                                           # [B,L,N,d_in]\n",
        "            o, att = self.gats[k](hk, hk.mean(1), A_b[:, k])\n",
        "            outs.append(o)\n",
        "            atts.append(att.mean(1))                                        # head-mean [B,N,N]\n",
        "        Hs = torch.stack(outs, dim=3)                                       # [B,L,N,K,d_out]\n",
        "        beta = torch.softmax(self.beta(z_last), dim=-1)                     # [B,K]\n",
        "        out = (Hs * beta.view(B, 1, 1, K, 1)).sum(dim=3)                    # [B,L,N,d_out]\n",
        "        return out, {\"beta\": beta, \"A_k\": A_k.detach(), \"event_gate\": gate,\n",
        "                     \"attn\": torch.stack(atts, 1).detach()}\n",
        "\n",
        "\n",
        "class AttentionLSTMDecoder(nn.Module):\n",
        "    \"\"\"⑤ TGALSTM's self-attention LSTM decoder, emitting H×2 (inbound & outbound) per node.\"\"\"\n",
        "\n",
        "    def __init__(self, d_in, hidden, horizon, n_out=2, dropout=0.1):\n",
        "        super().__init__()\n",
        "        self.lstm = nn.LSTM(d_in, hidden, batch_first=True)\n",
        "        self.attn = nn.Linear(hidden, 1)\n",
        "        self.head = nn.Sequential(nn.Linear(hidden, hidden), nn.ReLU(),\n",
        "                                  nn.Dropout(dropout), nn.Linear(hidden, horizon * n_out))\n",
        "        self.horizon, self.n_out = horizon, n_out\n",
        "\n",
        "    def forward(self, x):                       # x: [B, N, L, d_in]\n",
        "        B, N, Lx, D = x.shape\n",
        "        h, _ = self.lstm(x.reshape(B * N, Lx, D))\n",
        "        w = torch.softmax(self.attn(h), dim=1)\n",
        "        ctx = (w * h).sum(dim=1)\n",
        "        y = self.head(ctx).view(B, N, self.horizon, self.n_out)\n",
        "        return y.permute(0, 2, 1, 3).contiguous(), w.view(B, N, Lx)"
      ]
    },
