        "    _finish(ax, \"Diurnal profile per ticket code\", \"time of day\", None)\n",
        "    _safe_tight(fig)\n",
        "    return fig, pd.DataFrame(Mtx, index=[CARD_FEATS[\"label\"].iloc[i] for i in order])\n",
        "\n",
        "\n",
        "@figure(\"F06\", \"Fig. 6. Demand Concentration Lorenz Curve across Stations\", \"01_corpus\")\n",
        "def fig_demand_concentration():\n",
        "    tot = X_total.sum(axis=(0, 2)).astype(float)\n",
        "    s = np.sort(tot)[::-1]\n",
        "    cum = np.cumsum(s) / s.sum()\n",
        "    lor = np.cumsum(np.sort(tot)) / tot.sum()\n",
        "    x = np.arange(1, len(tot) + 1) / len(tot)\n",
        "    gini = 1 - 2 * np.trapezoid(lor, x) if hasattr(np, \"trapezoid\") else 1 - 2 * np.trapz(lor, x)\n",
        "\n",
        "    fig, axes = plt.subplots(1, 2, figsize=(12, 4))\n",
        "    axes[0].bar(range(len(s)), s / 1e3, color=M3[\"blue600\"], width=1.0)\n",
        "    _finish(axes[0], \"Station volume (ranked)\", \"station rank\", \"thousand taps\")\n",
        "    axes[0].set_yscale(\"log\")\n",
        "    axes[1].plot(x, lor, color=M3[\"blue600\"], lw=1.8)\n",
        "    axes[1].plot([0, 1], [0, 1], color=MUTED, ls=\"--\", lw=0.8)\n",
        "    axes[1].fill_between(x, lor, x, color=M3[\"blue600\"], alpha=0.15)\n",
        "    _finish(axes[1], f\"Lorenz curve (Gini={gini:.3f})\",\n",
        "            \"cumulative station share\", \"cumulative demand share\")\n",
        "    _safe_tight(fig)\n",
        "    return fig, pd.DataFrame({\"rank\": range(1, len(s) + 1), \"volume\": s, \"cum_share\": cum})\n"
      ]
    },
