        "\n",
        "@figure(\"F14\", \"Fig. 14. Spatial Graph Cosine Distinctness Comparison\", \"03_network\")\n",
        "def fig_graph_distinctness():\n",
        "    pairs = GRAPH[\"pairs\"].copy()\n",
        "    fig, axes = plt.subplots(1, 2, figsize=(12, 4), gridspec_kw={\"width_ratios\": [1.35, 1]})\n",
        "    labels = [f\"{a.split('/')[0]}\\nvs {b.split('/')[0]}\" for a, b in zip(pairs[\"a\"], pairs[\"b\"])]\n",
        "    ax = axes[0]\n",
        "    ax.bar(range(len(pairs)), pairs[\"cosine\"], color=M3[\"blue600\"], width=0.65)\n",
        "    ax.axhline(GRAPH[\"od_cosine\"], color=ACCENT, ls=\"--\", lw=1.5,\n",
        "               label=f\"O vs D = {GRAPH['od_cosine']:.4f}\")\n",
        "    ax.set_xticks(range(len(pairs)))\n",
        "    ax.set_xticklabels(labels, fontsize=7)\n",
        "    ax.set_ylim(min(0.5, pairs[\"cosine\"].min() - 0.05), 1.005)\n",
        "    ax.legend(loc=\"lower right\", fontsize=7)\n",
        "    _finish(ax, \"Pairwise cosine similarity\", None, \"cosine similarity\")\n",
        "    for i, v in enumerate(pairs[\"cosine\"]):\n",
        "        ax.text(i, v + 0.004, f\"{v:.3f}\", ha=\"center\", fontsize=7)\n",
        "\n",
        "    ax = axes[1]\n",
        "    ax.bar(range(len(pairs)), 100 * pairs[\"frac_gt_0.2\"], color=M3[\"green\"], width=0.65)\n",
        "    ax.set_xticks(range(len(pairs)))\n",
        "    ax.set_xticklabels(labels, fontsize=7)\n",
        "    _finish(ax, \"Entries differing by >0.2\", None, \"% of pairs\")\n",
        "    _safe_tight(fig)\n",
        "    return fig, pairs\n",
        "\n",
        "\n",
        "@figure(\"F15\", \"Fig. 15. Spatial-Temporal Network Flow Heatmap\", \"03_network\")\n",
        "def fig_flow_heatmap():\n",
        "    n_days = min(7, N_DAYS)\n",
        "    best, best_v = 0, -1\n",
        "    for s in range(0, max(N_DAYS - n_days + 1, 1)):\n",
        "        v = X_total[s * BINS_PER_DAY:(s + n_days) * BINS_PER_DAY].sum()\n",
        "        if v > best_v:\n",
        "            best, best_v = s, v\n",
        "    start = best\n",
        "    sl = slice(start * BINS_PER_DAY, (start + n_days) * BINS_PER_DAY)\n",
        "    M = X_total[sl].sum(axis=2).T\n",
        "    order = np.argsort(-M.sum(axis=1))\n",
        "    fig, ax = plt.subplots(figsize=(13, 5.5))\n",
        "    im = ax.imshow(M[order], aspect=\"auto\", cmap=SEQ, interpolation=\"nearest\",\n",
        "                   norm=LogNorm(vmin=max(M.min(), 1), vmax=max(M.max(), 2)))\n",
        "    ax.set_yticks(range(0, len(order), max(1, len(order) // 20)))\n",
        "    ax.set_yticklabels([str(int(STATION_IDS[order[i]]))\n",
        "                        for i in range(0, len(order), max(1, len(order) // 20))], fontsize=6.5)\n",
        "    tick = np.arange(0, n_days * BINS_PER_DAY, BINS_PER_DAY)\n",
        "    ax.set_xticks(tick)\n",
        "    ax.set_xticklabels([DAY_DATES[start + i].strftime(\"%a %d\") for i in range(n_days)], fontsize=7)\n",
        "    for t in tick[1:]:\n",
        "        ax.axvline(t, color=\"white\", lw=0.6, alpha=0.5)\n",
        "    ax.grid(False)\n",
        "    plt.colorbar(im, ax=ax, pad=0.01, label=\"taps/10min (log)\", shrink=0.85)\n",
        "    _finish(ax, \"Station x time flow surface\", None, \"station id\")\n",
        "    _safe_tight(fig)\n",
        "    d = pd.DataFrame({\n",
        "        \"station_id\": [int(STATION_IDS[order[i]]) for i in range(len(order))],\n",
        "        \"total_flow\": M[order].sum(axis=1),\n",
        "        \"peak_flow\": M[order].max(axis=1),\n",
        "        \"mean_flow\": M[order].mean(axis=1)\n",
        "    })\n",
        "    return fig, d\n",
        "\n",
        "\n",
        "# ═══════════════════════════════════════════════════════════════════════════════\n",
        "# EXECUTION SNIPPET — Render & Display Group 03 Figures (F12 - F15) Inline\n",
        "# ═══════════════════════════════════════════════════════════════════════════════\n",
        "for _fig_fn in [fig_network_graph, fig_adjacency_panel, fig_graph_distinctness, fig_flow_heatmap]:\n",
        "    try:\n",
        "        _fig, _d = _fig_fn()\n",
        "        if _fig is not None:\n",
        "            plt.show()\n",
        "    except Exception as _e:\n",
        "        print(f\"Notice: {_fig_fn.__name__} pending data context ({_e})\")\n"
      ]
    },
