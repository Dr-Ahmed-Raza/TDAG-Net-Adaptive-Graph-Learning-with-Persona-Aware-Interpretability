        "    axes[1].invert_yaxis()\n",
        "    axes[0].invert_yaxis()\n",
        "    _finish(axes[1], \"Assignment confidence\", \"max P\", None)\n",
        "    _safe_tight(fig)\n",
        "    return fig, pd.DataFrame(PERSONA_PRIOR, columns=[_pname(k) for k in range(K_PERSONA)],\n",
        "                             index=CARD_FEATS[\"label\"]).reset_index()\n",
        "\n",
        "\n",
        "@figure(\"F10\", \"Fig. 10. Persona Mix across Top 30 Busiest Stations\", \"02_persona\")\n",
        "def fig_persona_by_station():\n",
        "    tot = X_persona.sum(axis=(0, 2))\n",
        "    order = np.argsort(-tot.sum(axis=1))[:30]\n",
        "    frac = tot[order] / np.maximum(tot[order].sum(axis=1, keepdims=True), 1e-9)\n",
        "    fig, ax = plt.subplots(figsize=(13, 4.2))\n",
        "    bottom = np.zeros(len(order))\n",
        "    for k in range(K_PERSONA):\n",
        "        ax.bar(range(len(order)), 100 * frac[:, k], bottom=bottom,\n",
        "               color=PERSONA_COLORS[k], label=_pname(k), width=0.8)\n",
        "        bottom += 100 * frac[:, k]\n",
        "    ax.set_xticks(range(len(order)))\n",
        "    ax.set_xticklabels([str(STATION_IDS[i]) for i in order], fontsize=7)\n",
        "    ax.set_ylim(0, 100)\n",
        "    ax.legend(ncol=K_PERSONA, loc=\"upper right\", fontsize=7)\n",
        "    _finish(ax, \"Persona mix by station (top 30)\", \"station id\", \"% of volume\")\n",
        "    _safe_tight(fig)\n",
        "    d = pd.DataFrame(100 * frac, columns=[_pname(k) for k in range(K_PERSONA)])\n",
        "    d.insert(0, \"station_id\", STATION_IDS[order])\n",
        "    return fig, d\n",
        "\n",
        "\n",
        "@figure(\"F11\", \"Fig. 11. Persona Flow Autocorrelation (Daily & Weekly)\", \"02_persona\")\n",
        "def fig_persona_acf():\n",
        "    fig, ax = plt.subplots(figsize=(11, 3.8))\n",
        "    max_lag = min(BINS_PER_DAY * 8, T_STEPS // 3)\n",
        "    lags = np.arange(1, max_lag)\n",
        "    rows = []\n",
        "    for k in range(K_PERSONA):\n",
        "        s = X_persona[:, :, :, k].sum(axis=(1, 2)).astype(np.float64)\n",
        "        s = (s - s.mean()) / (s.std() + 1e-9)\n",
        "        acf = np.array([np.corrcoef(s[:-l], s[l:])[0, 1] if l < len(s) - 2 else np.nan for l in lags])\n",
        "        ax.plot(lags / BINS_PER_DAY, acf, lw=1.4, color=PERSONA_COLORS[k], label=_pname(k))\n",
        "        rows.append(pd.DataFrame({\"lag_days\": lags / BINS_PER_DAY, \"acf\": acf, \"persona\": _pname(k)}))\n",
        "    for d_ in range(1, 8):\n",
        "        ax.axvline(d_, color=MUTED, ls=\":\", lw=0.6)\n",
        "    ax.axhline(0, color=INK, lw=0.6)\n",
        "    ax.legend(ncol=K_PERSONA, fontsize=7)\n",
        "    _finish(ax, \"Persona flow autocorrelation\", \"lag (days)\", \"ACF\")\n",
        "    _safe_tight(fig)\n",
        "    return fig, pd.concat(rows, ignore_index=True)\n"
