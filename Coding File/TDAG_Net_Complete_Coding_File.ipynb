        "# ═══════════════════════════════════════════════════════════════════════════════\n",
        "# [13] PERSONA-CONDITIONED ADJACENCIES  A_k   +  the Option-A vs Option-B test\n",
        "# ═══════════════════════════════════════════════════════════════════════════════\n",
        "def _sparsify(C: np.ndarray, topk: int, thresh: float) -> np.ndarray:\n",
        "    A = np.where(np.abs(C) >= thresh, C, 0.0).astype(np.float32)\n",
        "    np.fill_diagonal(A, 0.0)\n",
        "    if topk and topk < A.shape[0]:\n",
        "        keep = np.zeros_like(A, dtype=bool)\n",
        "        idx = np.argsort(-np.abs(A), axis=1)[:, :topk]\n",
        "        np.put_along_axis(keep, idx, True, axis=1)\n",
        "        A = np.where(keep | keep.T, A, 0.0)\n",
        "    return np.maximum(A, A.T)\n",
        "\n",
        "\n",
        "def _corr_matrix(S: np.ndarray) -> np.ndarray:\n",
        "    \"\"\"S: [T, N] → Pearson correlation across stations, NaN-safe.\"\"\"\n",
        "    Sd = S - S.mean(axis=0, keepdims=True)\n",
        "    sd = Sd.std(axis=0, keepdims=True)\n",
        "    Sd = Sd / np.maximum(sd, 1e-8)\n",
        "    C = (Sd.T @ Sd) / max(S.shape[0] - 1, 1)\n",
        "    return np.nan_to_num(C, nan=0.0)\n",
        "\n",
        "\n",
        "@stage(\"A_persona\", depends_on=[\"dataset\", \"n_personas\", \"adj_topk\", \"corr_min\"],\n",
        "       ext=\"pkl\", subdir=\"graphs\")\n",
        "def build_persona_adjacency() -> dict:\n",
        "    A_k, C_k = [], []\n",
        "    for k in range(K_PERSONA):\n",
        "        S = X_persona[:, :, :, k].sum(axis=2)          # [T, N]\n",
        "        C = _corr_matrix(S.astype(np.float64))\n",
        "        C_k.append(C.astype(np.float32))\n",
        "        A_k.append(_sparsify(C, CFG.adj_topk, CFG.corr_min))\n",
        "    A_k = np.stack(A_k)                                 # [K, N, N]\n",
        "    C_k = np.stack(C_k)\n",
        "\n",
        "    # aggregate (persona-agnostic) reference graph\n",
        "    C_all = _corr_matrix(X_total.sum(axis=2).astype(np.float64))\n",
        "    A_all = _sparsify(C_all, CFG.adj_topk, CFG.corr_min)\n",
        "\n",
        "    # ── distinctness: cosine between flattened persona correlation graphs ────\n",
        "    def cos(a, b):\n",
        "        a, b = a.flatten(), b.flatten()\n",
        "        return float(a @ b / (np.linalg.norm(a) * np.linalg.norm(b) + 1e-9))\n",
        "\n",
        "    pairs = []\n",
        "    for i in range(K_PERSONA):\n",
        "        for j in range(i + 1, K_PERSONA):\n",
        "            pairs.append({\"a\": CFG.persona_names[i], \"b\": CFG.persona_names[j],\n",
        "                          \"cosine\": cos(C_k[i], C_k[j]),\n",
        "                          \"mean_abs_diff\": float(np.abs(C_k[i] - C_k[j]).mean()),\n",
        "                          \"frac_gt_0.2\": float((np.abs(C_k[i] - C_k[j]) > 0.2).mean())})\n",
        "    pair_df = pd.DataFrame(pairs)\n",
        "\n",
        "    # ── the direct Option-A comparison: origin-graph vs destination-graph ────\n",
        "    C_o = _corr_matrix(X_total[:, :, 0].astype(np.float64))\n",
        "    C_d = _corr_matrix(X_total[:, :, 1].astype(np.float64))\n",
        "    od_cosine = cos(C_o, C_d)\n",
        "\n",
        "    return {\"A_k\": A_k, \"C_k\": C_k, \"A_all\": A_all, \"C_all\": C_all,\n",
        "            \"pairs\": pair_df, \"od_cosine\": od_cosine,\n",
        "            \"C_origin\": C_o.astype(np.float32), \"C_dest\": C_d.astype(np.float32)}\n",
        "\n",
        "\n",
        "GRAPH = build_persona_adjacency()\n",
        "A_PERSONA = GRAPH[\"A_k\"]\n",
        "\n",
        "print(\"╔═ ARCHITECTURE DECISION EVIDENCE ════════════════════════════════════\")\n",
        "print(f\"║ Option A (rejected)  origin-graph vs destination-graph\")\n",
        "print(f\"║     cosine = {GRAPH['od_cosine']:.4f}   ← near-duplicate views \"\n",
        "      f\"(your earlier audit: 0.9861)\")\n",
        "print(\"║\")\n",
        "print(f\"║ Option B (adopted)   persona-graph pairwise distinctness\")\n",
        "for _, r in GRAPH[\"pairs\"].iterrows():\n",
        "    print(f\"║     {r['a'][:12]:<12s} vs {r['b'][:12]:<12s}  cosine = {r['cosine']:.4f}  \"\n",
        "          f\"│ {100 * r['frac_gt_0.2']:.1f}% of entries differ by >0.2\")\n",
        "_mean_persona_cos = GRAPH[\"pairs\"][\"cosine\"].mean()\n",
        "print(\"║\")\n",
        "if _mean_persona_cos < GRAPH[\"od_cosine\"]:\n",
        "    print(f\"║ ✅ Persona views are MORE distinct (mean cos {_mean_persona_cos:.4f} \"\n",
        "          f\"< OD {GRAPH['od_cosine']:.4f})\")\n",
        "    print(\"║    → PC-HGAT's K parallel branches carry information the O/D split did not.\")\n",
        "else:\n",
        "    print(f\"║ ⚠️  Persona views (mean cos {_mean_persona_cos:.4f}) are not more distinct \"\n",
        "          f\"than O/D ({GRAPH['od_cosine']:.4f}).\")\n",
        "    print(\"║    → Report this honestly; consider K=3 or a shared-adjacency ablation.\")\n",
        "print(\"╚\" + \"═\" * 68)\n",
        "save_df(GRAPH[\"pairs\"], f\"{P['graphs']}/persona_graph_distinctness_{CFG.dataset}.csv\")\n",
        "for _k in range(K_PERSONA):\n",
        "    print(f\"  A_{_k} ({CFG.persona_names[_k]:<20s}) edges={int((A_PERSONA[_k] != 0).sum() // 2):>5d} \"\n",
        "          f\"mean|w|={np.abs(A_PERSONA[_k][A_PERSONA[_k] != 0]).mean() if (A_PERSONA[_k] != 0).any() else 0:.3f}\")"
