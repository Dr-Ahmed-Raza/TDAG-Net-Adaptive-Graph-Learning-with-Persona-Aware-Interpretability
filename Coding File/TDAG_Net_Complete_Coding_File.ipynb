        "# [34] INTERPRETABILITY EXPORT — the numbers the Discussion section quotes\n",
        "# ═══════════════════════════════════════════════════════════════════════════════\n",
        "INTERP = {}\n",
        "if \"TDAG-Net\" in TRAINERS:\n",
        "    _m = TRAINERS[\"TDAG-Net\"].load_best()\n",
        "    if isinstance(_m, TDAGNet):\n",
        "        with torch.no_grad():\n",
        "            if _m.tdpdm is not None:\n",
        "                Pl = _m.tdpdm.assignment().cpu().numpy()\n",
        "                INTERP[\"persona_assignment_learned\"] = Pl.tolist()\n",
        "                INTERP[\"persona_assignment_drift\"] = float(np.abs(Pl - PERSONA_PRIOR).mean())\n",
        "                INTERP[\"alpha_event_volatility\"] = Fn.softplus(_m.tdpdm.alpha).cpu().numpy().tolist()\n",
        "                _hard = Pl.argmax(1)\n",
        "                INTERP[\"codes_that_switched_persona\"] = int(\n",
        "                    (_hard != PERSONA_PRIOR.argmax(1)).sum())\n",
        "            INTERP[\"gamma_ecaam\"] = Fn.softplus(_m.pchgat.ecaam.gamma).cpu().numpy().tolist()\n",
        "            INTERP[\"fusion_weights\"] = torch.softmax(_m.fuse_w, 0).cpu().numpy().tolist()\n",
        "            A = torch.stack([_m.pchgat.adapt[k](enabled=_m.use_adaptive)\n",
        "                             for k in range(_m.K)]).cpu().numpy()\n",
        "            save_npz(f\"{P['graphs']}/learned_adjacency_{CFG.dataset}.npz\", A=A)\n",
        "            INTERP[\"adjacency_sparsity\"] = [float((a > 1e-3).mean()) for a in A]\n",
        "        INTERP[\"persona_names\"] = list(CFG.persona_names)\n",
        "        INTERP[\"od_cosine_option_A\"] = GRAPH[\"od_cosine\"]\n",
        "        INTERP[\"persona_cosine_option_B_mean\"] = float(GRAPH[\"pairs\"][\"cosine\"].mean())\n",
        "        save_json(INTERP, f\"{P['results']}/interpretability_{CFG.dataset}.json\")\n",
        "\n",
        "        print(\"╔═ INTERPRETABILITY ══════════════════════════════════════════════════════\")\n",
        "        if \"alpha_event_volatility\" in INTERP:\n",
        "            print(\"║ α_k (event volatility, learned):\")\n",
        "            for k, v in enumerate(INTERP[\"alpha_event_volatility\"]):\n",
        "                print(f\"║    {CFG.persona_names[k]:<22s} {v:.4f}\")\n",
        "            print(f\"║ Codes that changed persona during training: \"\n",
        "                  f\"{INTERP['codes_that_switched_persona']} / {N_CARD}\")\n",
        "            print(f\"║ Mean |P* − P₀| drift: {INTERP['persona_assignment_drift']:.4f}\")\n",
        "        print(\"║ γ_k (EC-AAM event-adjacency strength):\")\n",
        "        for k, v in enumerate(INTERP[\"gamma_ecaam\"]):\n",
        "            nm = CFG.persona_names[k] if k < K_PERSONA else f\"branch {k}\"\n",
        "            print(f\"║    {nm:<22s} {v:.4f}\")\n",
        "        _g = INTERP[\"gamma_ecaam\"]\n",
        "        if len(_g) == K_PERSONA:\n",
        "            _lead = int(np.argmax(_g))\n",
        "            print(f\"║ → the {CFG.persona_names[_lead]} graph reacts most strongly to events \"\n",
        "                  f\"(γ={_g[_lead]:.3f})\")\n",
        "            print(\"║   The proposal predicted casual/tourist would lead — \"\n",
        "                  \"report whether it did.\")\n",
        "        print(f\"║ Weighted fusion (temporal / persona-graph / topology-graph): \"\n",
        "              f\"{np.round(INTERP['fusion_weights'], 3).tolist()}\")\n",
        "        print(\"╚\" + \"═\" * 72)"
