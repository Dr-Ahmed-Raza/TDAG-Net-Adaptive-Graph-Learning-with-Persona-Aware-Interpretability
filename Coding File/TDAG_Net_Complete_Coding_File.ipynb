      "source": [
        "# ═══════════════════════════════════════════════════════════════════════════════\n",
        "# [01] CONFIGURATION — single source of truth\n",
        "# ═══════════════════════════════════════════════════════════════════════════════\n",
        "from dataclasses import dataclass, field, asdict\n",
        "from typing import List, Dict, Optional, Tuple\n",
        "\n",
        "if IN_COLAB:\n",
        "    _DRIVE = \"/content/drive/MyDrive\"\n",
        "else:\n",
        "    _DRIVE = os.path.abspath(os.environ.get(\"TDAG_DRIVE\", \".\"))\n",
        "\n",
        "\n",
        "@dataclass\n",
        "class Config:\n",
        "    # ── Paths ────────────────────────────────────────────────────────────────\n",
        "    drive_root: str = _DRIVE\n",
        "    dataset_root: str = f\"{_DRIVE}/Dataset/2nd SCI-T1 paper\"\n",
        "    project_root: str = f\"{_DRIVE}/TDAG_Net\"\n",
        "    legacy_manifest: str = f\"{_DRIVE}/afc_file_manifest.csv\"   # from your earlier notebook\n",
        "\n",
        "    # ── Which corpus ─────────────────────────────────────────────────────────\n",
        "    dataset: str = \"2023\"            # \"2023\" (primary) | \"2018\" (generalisation)\n",
        "    exclude_station_ids: Tuple[int, ...] = (333,)   # audit: 1 record → artifact\n",
        "\n",
        "    # ── Temporal discretisation ──────────────────────────────────────────────\n",
        "    freq_minutes: int = 10\n",
        "    service_start: str = \"06:00\"\n",
        "    service_end: str = \"23:50\"\n",
        "    min_records_per_day: int = 200_000   # a day below this is partial → excluded\n",
        "\n",
        "    # ── Ticket / persona ─────────────────────────────────────────────────────\n",
        "    n_card_channels: int = 24        # top-N card types kept, rest → \"OTHER\"\n",
        "    n_personas: int = 4              # K\n",
        "    persona_names: Tuple[str, ...] = (\"Commuter\", \"Casual\", \"Tourist/Visitor\", \"Concession/Student\")\n",
        "\n",
        "    # ── Windowing ────────────────────────────────────────────────────────────\n",
        "    seq_len: int = 12                # L  (2 h of history at 10-min steps)\n",
        "    horizon: int = 6                 # H  (1 h ahead); metrics reported per-step too\n",
        "    train_frac: float = 0.70         # chronological, by day\n",
        "    val_frac: float = 0.15\n",
        "\n",
        "    # ── Graph ────────────────────────────────────────────────────────────────\n",
        "    adj_topk: int = 8                # sparsify learned/correlation adjacency\n",
        "    venue_radius_km: float = 3.0     # EC-AAM proximity radius\n",
        "    corr_min: float = 0.30           # min |corr| to keep an edge\n",
        "\n",
        "    # ── Model ────────────────────────────────────────────────────────────────\n",
        "    hidden_dim: int = 64\n",
        "    tcn_channels: int = 64\n",
        "    tcn_dilations: Tuple[int, ...] = (1, 2, 4, 8)\n",
        "    gat_heads: int = 4\n",
        "    gat_dropout: float = 0.10\n",
        "    lstm_hidden: int = 128\n",
        "    dropout: float = 0.10\n",
        "    node_emb_dim: int = 16           # adaptive-adjacency node embeddings\n",
        "\n",
        "    # ── Training ─────────────────────────────────────────────────────────────\n",
        "    batch_size: int = 32\n",
        "    epochs: int = 80\n",
        "    lr: float = 3e-4                 # TGALSTM used 3e-4 — kept for comparability\n",
        "    weight_decay: float = 1e-4\n",
        "    huber_delta: float = 1.0         # ← TABULATED (TGALSTM never reported it)\n",
        "    grad_clip: float = 5.0\n",
        "    early_stop_patience: int = 15\n",
        "    lr_patience: int = 6\n",
        "    amp: bool = True\n",
        "    aux_persona_weight: float = 0.05   # TD-PDM soft-assignment regulariser\n",
        "    aux_entropy_weight: float = 0.01\n",
        "\n",
        "    # ── Checkpointing / resume ───────────────────────────────────────────────\n",
        "    ckpt_every_epochs: int = 1\n",
        "    ckpt_every_minutes: float = 5.0   # survives Colab idle-disconnects mid-epoch\n",
        "    keep_last_n_ckpts: int = 2\n",
        "\n",
        "    # ── Reproducibility ──────────────────────────────────────────────────────\n",
        "    seed: int = 42\n",
        "    deterministic: bool = False       # True → slower but bit-reproducible\n",
        "\n",
        "    # ── Execution control ────────────────────────────────────────────────────\n",
        "    quick_test: bool = False          # tiny run to validate the pipeline\n",
        "    force_recompute: Tuple[str, ...] = ('C_venue', 'exogenous')\n",
        "    preload_to_gpu: bool = True\n",
        "    chunksize: int = 2_000_000        # rows per pandas chunk during ingestion\n",
        "    n_ingest_files: int = -1          # -1 = all; set small for a dry run\n",
        "\n",
        "    # ── Evaluation ───────────────────────────────────────────────────────────\n",
        "    event_peak_quantile: float = 0.90   # EPE is measured on the top-decile intervals\n",
        "    report_stations: Tuple[int, ...] = ()   # filled after station index is built\n",
        "\n",
        "    def __post_init__(self):\n",
        "        if self.quick_test:\n",
        "            self.epochs = 3\n",
        "            self.n_ingest_files = 3\n",
        "            self.early_stop_patience = 99\n",
        "\n",
        "    # Cache-key: only fields that actually change a given stage's output\n",
        "    def hash_of(self, fields: List[str]) -> str:\n",
        "        import hashlib\n",
        "        import json as _json\n",
        "        payload = {k: getattr(self, k) for k in fields}\n",
        "        blob = _json.dumps(payload, sort_keys=True, default=str)\n",
        "        return hashlib.md5(blob.encode()).hexdigest()[:10]\n",
        "\n",
        "\n",
        "CFG = Config()\n",
        "\n",
        "# ── Derived paths ────────────────────────────────────────────────────────────\n",
        "P = {\n",
        "    \"root\":      CFG.project_root,\n",
        "    \"cache\":     f\"{CFG.project_root}/cache\",\n",
        "    \"agg\":       f\"{CFG.project_root}/cache/agg\",\n",
        "    \"tensors\":   f\"{CFG.project_root}/cache/tensors\",\n",
        "    \"graphs\":    f\"{CFG.project_root}/cache/graphs\",\n",
        "    \"personas\":  f\"{CFG.project_root}/cache/personas\",\n",
        "    \"events\":    f\"{CFG.project_root}/cache/events\",\n",
        "    \"meta\":      f\"{CFG.project_root}/data/metadata\",\n",
        "    \"runs\":      f\"{CFG.project_root}/runs\",\n",
        "    \"figures\":   f\"{CFG.project_root}/figures\",\n",
        "    \"results\":   f\"{CFG.project_root}/results\",\n",
        "    \"metrics\":   f\"{CFG.project_root}/results/metrics\",\n",
        "    \"tables\":    f\"{CFG.project_root}/results/tables\",\n",
        "    \"preds\":     f\"{CFG.project_root}/results/predictions\",\n",
        "    \"exports\":   f\"{CFG.project_root}/exports\",\n",
        "    \"logs\":      f\"{CFG.project_root}/logs\",\n",
        "}\n",
        "\n",
        "print(\"Configuration loaded.\")\n",
        "print(f\"  dataset      : {CFG.dataset}\")\n",
        "print(f\"  project root : {CFG.project_root}\")\n",
        "print(f\"  quick_test   : {CFG.quick_test}\")\n",
        "print(f\"  L → H        : {CFG.seq_len} steps in → {CFG.horizon} steps out \"\n",
        "      f\"({CFG.seq_len * CFG.freq_minutes} min → {CFG.horizon * CFG.freq_minutes} min)\")"
      ]
    },
