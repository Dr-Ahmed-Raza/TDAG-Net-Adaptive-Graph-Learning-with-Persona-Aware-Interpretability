        "@figure(\"F12\", \"Inferred metro topology, coloured by line and sized by ridership\", \"03_network\")\n",
        "def fig_network_graph():\n",
        "    G = nx.from_numpy_array(A_TOPO)\n",
        "    mapping = {i: int(STATION_IDS[i]) for i in range(N_STATIONS)}\n",
        "    G = nx.relabel_nodes(G, mapping)\n",
        "    tot = X_total.sum(axis=(0, 2)).astype(float)\n",
        "    lines = np.array([STATION_LINE.get(int(s), 0) for s in STATION_IDS])\n",
        "    uniq = sorted(set(lines.tolist()))\n",
        "    cmap = plt.get_cmap(\"tab20\")\n",
        "    node_color = [cmap(uniq.index(l) % 20) for l in lines]\n",
        "    node_size = 20 + 620 * (tot / max(tot.max(), 1)) ** 0.6\n",
        "\n",
        "    if HAS_COORDS:\n",
        "        md = STATION_META.set_index(\"station_id\")\n",
        "        pos = {int(s): (float(md[\"longitude\"].get(int(s), 0)), float(md[\"latitude\"].get(int(s), 0)))\n",
        "               for s in STATION_IDS}\n",
        "        layout_note = \"geographic (lon/lat)\"\n",
        "    else:\n",
        "        pos = nx.spring_layout(G, seed=CFG.seed, k=1.6 / np.sqrt(max(N_STATIONS, 2)), iterations=220)\n",
        "        layout_note = \"force-directed (no coordinates supplied)\"\n",
        "\n",
        "    fig, ax = plt.subplots(figsize=(11, 9))\n",
        "    nx.draw_networkx_edges(G, pos, ax=ax, edge_color=\"#c9d3db\", width=1.0, alpha=0.9)\n",
        "    nx.draw_networkx_nodes(G, pos, ax=ax, node_color=node_color, node_size=node_size,\n",
        "                           edgecolors=\"white\", linewidths=0.7)\n",
        "    for i in np.argsort(-tot)[:12]:\n",
        "        ax.annotate(str(int(STATION_IDS[i])), pos[int(STATION_IDS[i])],\n",
        "                    fontsize=8, weight=\"bold\", ha=\"center\", va=\"center\")\n",
        "    ax.set_axis_off()\n",
        "    ax.set_title(f\"Inferred network — {int(A_TOPO.sum() // 2)} edges · layout: {layout_note}\\n\"\n",
