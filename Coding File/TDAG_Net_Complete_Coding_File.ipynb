        "# ═══════════════════════════════════════════════════════════════════════════════\n",
        "# [32] RESULTS TABLES —\n",
        "# ═══════════════════════════════════════════════════════════════════════════════\n",
        "METRIC_COLS = [\"RMSE\", \"MAE\", \"WMAPE\", \"R2\", \"EPE\", \"NDE\"]\n",
        "\n",
        "rename_display = {\n",
        "    \"TDAG-Net\": \"TDAG-Net (Input-Splitter)\",\n",
        "    \"TDAG-Net w/o TD-PDM\": \"TDAG-Net (ours)\"\n",
        "}\n",
        "\n",
        "def results_frame(scope=\"overall\"):\n",
        "    rows = []\n",
        "    for name in EXPERIMENT_QUEUE:\n",
        "        display_name = rename_display.get(name, name)\n",
        "        lookup_key = display_name if display_name in RESULTS else name\n",
        "        if lookup_key not in RESULTS or not RESULTS[lookup_key].get(scope):\n",
        "            continue\n",
        "        r = {\"Model\": display_name, **{k: RESULTS[lookup_key][scope].get(k, np.nan) for k in METRIC_COLS}}\n",
        "        r[\"Params\"] = RESULTS[lookup_key][\"params\"]\n",
        "        r[\"Epochs\"] = RESULTS[lookup_key][\"epochs\"]\n",
        "        rows.append(r)\n",
        "    return pd.DataFrame(rows)\n",
        "\n",
        "\n",
        "def to_latex(df, caption, label, bold_best=True):\n",
        "    d = df.copy()\n",
        "    fmt = {\"RMSE\": \"{:.3f}\", \"MAE\": \"{:.3f}\", \"WMAPE\": \"{:.2f}\", \"R2\": \"{:.4f}\",\n",
        "           \"EPE\": \"{:.2f}\", \"NDE\": \"{:.2f}\", \"Params\": \"{:,}\", \"Epochs\": \"{:.0f}\"}\n",
        "    best = {}\n",
        "    for c in METRIC_COLS:\n",
        "        if c in d.columns and d[c].notna().any():\n",
        "            best[c] = d[c].idxmax() if c == \"R2\" else d[c].idxmin()\n",
        "    for c, f in fmt.items():\n",
        "        if c in d.columns:\n",
        "            d[c] = d[c].map(lambda v: f.format(v) if pd.notna(v) else \"--\")\n",
        "    if bold_best:\n",
        "        for c, i in best.items():\n",
        "            d.loc[i, c] = r\"\\textbf{\" + str(d.loc[i, c]) + \"}\"\n",
        "    body = d.to_latex(index=False, escape=False, column_format=\"l\" + \"r\" * (len(d.columns) - 1))\n",
        "    return (f\"\\\\begin{{table}}[!t]\\n\\\\caption{{{caption}}}\\n\\\\label{{{label}}}\\n\"\n",
        "            f\"\\\\centering\\n\\\\footnotesize\\n{body}\\\\end{{table}}\\n\")\n",
        "\n",
        "\n",
        "TBL_MAIN = results_frame(\"overall\")\n",
        "TBL_EVENT = results_frame(\"event\")\n",
        "TBL_NORMAL = results_frame(\"normal\")\n",
        "\n",
        "if len(TBL_MAIN):\n",
        "    print(\"╔═ MAIN RESULTS — full test set ═══════════════════════════════════════════\")\n",
        "    print(TBL_MAIN.to_string(index=False, float_format=lambda v: f\"{v:,.4f}\"))\n",
        "    save_df(TBL_MAIN, f\"{P['tables']}/main_results_{CFG.dataset}.csv\")\n",
        "    save_df(TBL_EVENT, f\"{P['tables']}/event_results_{CFG.dataset}.csv\")\n",
        "    save_df(TBL_NORMAL, f\"{P['tables']}/normal_results_{CFG.dataset}.csv\")\n",
        "\n",
        "    tex = to_latex(TBL_MAIN.drop(columns=[\"Epochs\"]),\n",
        "                   f\"Network-wide prediction performance on the Nanjing {CFG.dataset} AFC test set \"\n",
        "                   f\"({N_STATIONS} stations, {CFG.freq_minutes}-min intervals, \"\n",
        "                   f\"horizon {H} steps). Huber $\\\\delta={CFG.huber_delta}$.\",\n",
        "                   \"tab:main_results\")\n",
        "    if len(TBL_EVENT):\n",
        "        tex += \"\\n\" + to_latex(TBL_EVENT.drop(columns=[\"Epochs\", \"Params\"]),\n",
        "                               \"Performance restricted to flagged event days.\",\n",
        "                               \"tab:event_results\")\n",
        "    with open(f\"{P['tables']}/results_{CFG.dataset}.tex\", \"w\", encoding=\"utf-8\") as f:\n",
        "        f.write(tex)\n",
        "    print(f\"\\nLaTeX written → {P['tables']}/results_{CFG.dataset}.tex\")\n",
        "\n",
        "    target_model = \"TDAG-Net (ours)\" if \"TDAG-Net (ours)\" in TBL_MAIN[\"Model\"].values else \"TDAG-Net\"\n",
        "    if target_model in TBL_MAIN[\"Model\"].values:\n",
        "        base = [m for m in TBL_MAIN[\"Model\"] if not m.startswith(\"TDAG-Net\")]\n",
        "        if base:\n",
        "            b = TBL_MAIN.set_index(\"Model\").loc[base]\n",
        "            best_base = b[\"RMSE\"].idxmin()\n",
        "            ours = TBL_MAIN.set_index(\"Model\").loc[target_model]\n",
        "            print(f\"\\n{target_model} vs best baseline ({best_base}):\")\n",
        "            for c in METRIC_COLS:\n",
        "                if pd.isna(ours[c]) or pd.isna(b.loc[best_base, c]):\n",
        "                    continue\n",
        "                diff = b.loc[best_base, c] - ours[c]\n",
        "                d = 100 * diff / abs(b.loc[best_base, c])\n",
        "                arrow = \"↑\" if (c == \"R2\" and diff < 0) or (c != \"R2\" and diff > 0) else \"↓\"\n",
        "                print(f\"   {c:<6s} {b.loc[best_base, c]:10.4f} → {ours[c]:10.4f}   \"\n",
        "                      f\"{arrow}{abs(d):5.2f}%\")\n",
        "\n",
        "    if len(TBL_EVENT):\n",
        "        print(\"\\n╔═ EVENT-DAY RESULTS ═════════════════════════════════════════════════════\")\n",
        "        print(TBL_EVENT.to_string(index=False, float_format=lambda v: f\"{v:,.4f}\"))\n"
