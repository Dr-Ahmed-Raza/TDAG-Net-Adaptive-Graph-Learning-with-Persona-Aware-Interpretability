        "    ax.plot(t, yt[sel, 0, ni, 0], lw=2.0, color=INK, label=\"actual\")\n",
        "    ax.plot(t, yp[sel, 0, ni, 0], lw=1.8, color=ACCENT, label=\"TDAG-Net\")\n",
        "    if base_name:\n",
        "        ax.plot(t, PREDICTIONS[base_name][1][sel, 0, ni, 0], lw=1.2, ls=\"--\",\n",
        "                color=\"#7aa6c9\", label=base_name)\n",
        "    pk = int(np.argmax(yt[sel, 0, ni, 0]))\n",
        "    ax.annotate(f\"peak {yt[sel, 0, ni, 0][pk]:.0f}\",\n",
        "                xy=(t[pk], yt[sel, 0, ni, 0][pk]), xytext=(10, 12),\n",
        "                textcoords=\"offset points\", color=INK, fontsize=8,\n",
        "                arrowprops=dict(arrowstyle=\"->\", color=INK, lw=0.8))\n",
        "    ax.legend(fontsize=8)\n",
        "    _finish(ax, f\"Stn {int(STATION_IDS[ni])} event day zoom\", None, \"taps/10min\")\n",
        "    ax.xaxis.set_major_formatter(mdates.DateFormatter(\"%H:%M\"))\n",
        "    _safe_tight(fig)\n",
        "    d = pd.DataFrame({\"t\": t, \"actual\": yt[sel, 0, ni, 0], \"tdagnet\": yp[sel, 0, ni, 0]})\n",
        "    return fig, d\n",
        "\n",
        "\n",
        "@figure(\"F26\", \"Fig. 26. Architectural Component Ablation Study\", \"06_results\")\n",
        "def fig_ablation():\n",
        "    have = [m for m in [\"TDAG-Net\"] + ABLATIONS if m in RESULTS]\n",
        "    if len(have) < 2:\n",
        "        return None, None\n",
        "    d = pd.DataFrame([{\"variant\": m, **{c: RESULTS[m][\"overall\"][c] for c in METRIC_COLS}}\n",
        "                      for m in have])\n",
        "    full = d[d[\"variant\"] == \"TDAG-Net\"].iloc[0]\n",
        "    d[\"dRMSE\"] = 100 * (d[\"RMSE\"] - full[\"RMSE\"]) / full[\"RMSE\"]\n",
        "    d[\"dWMAPE\"] = 100 * (d[\"WMAPE\"] - full[\"WMAPE\"]) / full[\"WMAPE\"]\n",
        "    d[\"dEPE\"] = 100 * (d[\"EPE\"] - full[\"EPE\"]) / max(full[\"EPE\"], 1e-9)\n",
        "    fig, axes = plt.subplots(1, 3, figsize=(14, 3.8))\n",
        "    for ax, c, t in zip(axes, [\"dRMSE\", \"dWMAPE\", \"dEPE\"],\n",
        "                        [\"RMSE\", \"WMAPE\", \"EPE\"]):\n",
        "        s = d[d[\"variant\"] != \"TDAG-Net\"].sort_values(c)\n",
        "        ax.barh(range(len(s)), s[c], color=np.where(s[c] > 0, ACCENT, M3[\"green\"]),\n",
        "                height=0.6)\n",
        "        ax.set_yticks(range(len(s)))\n",
        "        ax.set_yticklabels([v.replace(\"TDAG-Net w/o \", \"- \") for v in s[\"variant\"]], fontsize=8)\n",
        "        ax.axvline(0, color=INK, lw=0.8)\n",
        "        ax.invert_yaxis()\n",
        "        _finish(ax, f\"Delta {t}\", \"% change\", None)\n",
        "        for i, v in enumerate(s[c]):\n",
        "            ax.text(v, i, f\" {v:+.1f}%\", va=\"center\", fontsize=7.5)\n",
        "    _safe_tight(fig)\n",
        "    return fig, d\n",
        "\n",
        "\n",
        "@figure(\"F27\", \"Fig. 27. TD-PDM Soft-Assignment Matrix Audit (P0 vs P*)\", \"06_results\")\n",
        "def fig_learned_persona():\n",
        "    if \"TDAG-Net\" not in TRAINERS:\n",
        "        return None, None\n",
        "    m = TRAINERS[\"TDAG-Net\"].load_best()\n",
        "    if not isinstance(m, TDAGNet) or m.tdpdm is None:\n",
        "        return None, None\n",
        "    with torch.no_grad():\n",
        "        Pl = m.tdpdm.assignment().cpu().numpy()\n",
        "        alpha = Fn.softplus(m.tdpdm.alpha).cpu().numpy()\n",
        "    order = np.argsort(-CARD_FEATS[\"share_pct\"].to_numpy())\n",
        "    fig, axes = plt.subplots(1, 3, figsize=(14, max(4.2, 0.22 * N_CARD)),\n",
        "                             gridspec_kw={\"width_ratios\": [1, 1, 0.85]})\n",
        "    panels = [\n",
        "        (axes[0], PERSONA_PRIOR[order], \"Prior P0\", SEQ, 0, 1),\n",
        "        (axes[1], Pl[order], \"Learned P*\", SEQ, 0, 1),\n",
        "        (axes[2], (Pl - PERSONA_PRIOR)[order], \"Movement P*-P0\", DIV, -0.5, 0.5),\n",
        "    ]\n",
        "    for ax, M, t, cm, lo, hi in panels:\n",
        "        im = ax.imshow(M, aspect=\"auto\", cmap=cm, vmin=lo, vmax=hi, interpolation=\"nearest\")\n",
        "        ax.set_xticks(range(K_PERSONA))\n",
        "        ax.set_xticklabels([_pname(k).split(\"/\")[0] for k in range(K_PERSONA)],\n",
        "                           rotation=30, ha=\"right\", fontsize=7)\n",
        "        ax.set_yticks(range(len(order)))\n",
        "        ax.set_yticklabels([CARD_FEATS[\"label\"].iloc[i] for i in order]\n",
        "                           if ax is axes[0] else [], fontsize=6.5)\n",
        "        ax.grid(False)\n",
        "        ax.set_title(t, fontsize=9, loc=\"left\", fontweight=\"bold\")\n",
        "        plt.colorbar(im, ax=ax, fraction=0.046, pad=0.02, shrink=0.85)\n",
        "        if M.shape[0] <= 20:\n",
        "            _heatmap_annot(ax, M, fmt=\".2f\", fs=5)\n",
        "    _safe_tight(fig)\n",
        "    d = pd.DataFrame(Pl, columns=[_pname(k) for k in range(K_PERSONA)])\n",
        "    d.insert(0, \"card\", CARD_FEATS[\"label\"])\n",
        "    return fig, d\n",
        "\n",
        "\n",
        "@figure(\"F28\", \"Fig. 28. Learned Persona Adaptive Adjacencies A_adapt\", \"06_results\")\n",
        "def fig_learned_adjacency():\n",
        "    if \"TDAG-Net\" not in TRAINERS:\n",
        "        return None, None\n",
        "    m = TRAINERS[\"TDAG-Net\"].load_best()\n",
        "    if not isinstance(m, TDAGNet):\n",
        "        return None, None\n",
        "    with torch.no_grad():\n",
        "        A = torch.stack([m.pchgat.adapt[k](enabled=m.use_adaptive)\n",
        "                         for k in range(m.K)]).cpu().numpy()\n",
        "        gamma = Fn.softplus(m.pchgat.ecaam.gamma).cpu().numpy()\n",
        "    order = np.argsort([STATION_LINE.get(int(s), 99) for s in STATION_IDS])\n",
        "    fig, axes = plt.subplots(1, m.K + 1, figsize=(3.5 * (m.K + 1), 3.6))\n",
        "    for k in range(m.K):\n",
        "        ordered = A[k][np.ix_(order, order)]\n",
        "        im = axes[k].imshow(ordered, cmap=SEQ, interpolation=\"nearest\")\n",
        "        if A[k].shape[0] <= 20:\n",
        "            _heatmap_annot(axes[k], ordered, fmt=\".1f\", fs=4)\n",
        "        axes[k].set_title(f\"A_{k} {_pname(k) if k < K_PERSONA else 'shared'}\\ngamma={gamma[k]:.3f}\",\n",
        "                          fontsize=8, loc=\"left\", fontweight=\"bold\")\n",
        "        axes[k].set_xticks([])\n",
        "        axes[k].set_yticks([])\n",
        "        axes[k].grid(False)\n",
        "        plt.colorbar(im, ax=axes[k], fraction=0.046, pad=0.02, shrink=0.85)\n",
        "    axes[-1].bar(range(len(gamma)), gamma,\n",
        "                 color=[PERSONA_COLORS[k % len(PERSONA_COLORS)] for k in range(len(gamma))],\n",
        "                 width=0.6)\n",
        "    axes[-1].set_xticks(range(len(gamma)))\n",
        "    axes[-1].set_xticklabels([_pname(k).split(\"/\")[0] for k in range(len(gamma))],\n",
        "                             rotation=35, ha=\"right\", fontsize=7)\n",
        "    _finish(axes[-1], \"EC-AAM gamma_k\")\n",
        "    _safe_tight(fig)\n",
        "    return fig, pd.DataFrame({\"persona\": [_pname(k) for k in range(len(gamma))], \"gamma\": gamma})\n",
        "\n",
        "\n",
        "@figure(\"F29\", \"Fig. 29. Cross-Persona Fusion Gates beta_k(z_t) Dynamics\", \"06_results\")\n",
        "def fig_fusion_gates():\n",
        "    if \"TDAG-Net\" not in TRAINERS:\n",
        "        return None, None\n",
        "    m = TRAINERS[\"TDAG-Net\"].load_best()\n",
        "    if not isinstance(m, TDAGNet):\n",
        "        return None, None\n",
        "    m.eval()\n",
        "    idx = IDX_TE[: min(len(IDX_TE), 1500)]\n",
        "    betas, hours, evs = [], [], []\n",
        "    with torch.no_grad():\n",
        "        for i in range(0, len(idx), CFG.batch_size):\n",
        "            b = gather(idx[i:i + CFG.batch_size],\n",
        "                       need_card=isinstance(m, TDAGNet) and m.use_tdpdm)\n",
        "            _, aux = m(b, return_aux=True)\n",
        "            betas.append(aux[\"beta\"].float().cpu().numpy())\n",
        "            hours.extend(TIME_INDEX[idx[i:i + CFG.batch_size] + L - 1].hour +\n",
        "                         TIME_INDEX[idx[i:i + CFG.batch_size] + L - 1].minute / 60)\n",
        "            evs.extend(b[\"event\"][:, -1].float().cpu().numpy())\n",
        "    B = np.concatenate(betas)\n",
        "    d = pd.DataFrame(B, columns=[_pname(k) for k in range(B.shape[1])])\n",
        "    d[\"hour\"] = np.round(np.array(hours) * 2) / 2\n",
        "    d[\"event\"] = np.array(evs) > 0.5\n",
        "    fig, axes = plt.subplots(1, 2, figsize=(13, 3.8), gridspec_kw={\"width_ratios\": [1.6, 1]})\n",
        "    g = d.groupby(\"hour\")[[_pname(k) for k in range(B.shape[1])]].mean()\n",
        "    bottom = np.zeros(len(g))\n",
        "    for k in range(B.shape[1]):\n",
        "        axes[0].fill_between(g.index, bottom, bottom + g.iloc[:, k],\n",
        "                             color=PERSONA_COLORS[k % 4], alpha=0.8, label=_pname(k))\n",
        "        bottom += g.iloc[:, k].to_numpy()\n",
        "    axes[0].legend(ncol=4, fontsize=7)\n",
        "    _finish(axes[0], \"Beta_k by time of day\", \"hour\", \"gate weight\")\n",
        "    if d[\"event\"].any() and (~d[\"event\"]).any():\n",
        "        cmp_ = d.groupby(\"event\")[[_pname(k) for k in range(B.shape[1])]].mean().T\n",
        "        w = 0.34\n",
        "        axes[1].bar(np.arange(len(cmp_)) - w/2, cmp_[False], w, color=M3[\"blue100\"], label=\"normal\")\n",
        "        axes[1].bar(np.arange(len(cmp_)) + w/2, cmp_[True], w, color=ACCENT, label=\"event\")\n",
        "        axes[1].set_xticks(range(len(cmp_)))\n",
        "        axes[1].set_xticklabels([c.split(\"/\")[0] for c in cmp_.index], fontsize=7.5)\n",
        "        axes[1].legend(fontsize=7)\n",
        "        _finish(axes[1], \"Event vs normal gates\")\n",
        "    else:\n",
        "        axes[1].set_axis_off()\n",
        "    _safe_tight(fig)\n",
        "    return fig, d\n",
        "\n",
        "\n",
        "@figure(\"F30\", \"Fig. 30. Persona Attribution of Predicted Event Peaks\", \"06_results\")\n",
        "def fig_persona_attribution():\n",
        "    if \"TDAG-Net\" not in TRAINERS or not TEST_EVENT_MASK.any():\n",
        "        return None, None\n",
        "    m = TRAINERS[\"TDAG-Net\"].load_best()\n",
        "    if not isinstance(m, TDAGNet) or not m.use_tdpdm:\n",
        "        return None, None\n",
        "    m.eval()\n",
        "    ev_idx = IDX_TE[TEST_EVENT_MASK]\n",
        "    rows = []\n",
        "    with torch.no_grad():\n",
        "        for i in range(0, len(ev_idx), CFG.batch_size):\n",
        "            sel = ev_idx[i:i + CFG.batch_size]\n",
        "            b = gather(sel, need_card=True)\n",
        "            _, aux = m(b, return_aux=True)\n",
        "            xp = aux[\"persona_channels\"][:, -1].sum(dim=2).float().cpu().numpy()\n",
        "            for j, s in enumerate(sel):\n",
        "                ni = int(np.argmax(xp[j].sum(axis=1)))\n",
        "                tot = xp[j, ni].sum()\n",
        "                if tot <= 0:\n",
        "                    continue\n",
        "                rows.append({\"start\": int(s),\n",
        "                             \"date\": TENS[\"days\"][TENS[\"day_index\"][s + L]],\n",
        "                             \"station_id\": int(STATION_IDS[ni]),\n",
        "                             \"time\": str(TIME_INDEX[s + L].time()),\n",
        "                             **{_pname(k): float(100 * xp[j, ni, k] / tot)\n",
        "                                for k in range(K_PERSONA)}})\n",
        "    if not rows:\n",
        "        return None, None\n",
        "    d = pd.DataFrame(rows)\n",
        "    agg = d.groupby(\"station_id\")[[_pname(k) for k in range(K_PERSONA)]].mean()\n",
        "    cnt = d.groupby(\"station_id\").size()\n",
        "    agg = agg.loc[cnt.sort_values(ascending=False).index[:12]]\n",
        "    fig, axes = plt.subplots(1, 2, figsize=(13, 4.2), gridspec_kw={\"width_ratios\": [1.5, 1]})\n",
        "    bottom = np.zeros(len(agg))\n",
        "    for k in range(K_PERSONA):\n",
        "        axes[0].bar(range(len(agg)), agg[_pname(k)], bottom=bottom,\n",
        "                    color=PERSONA_COLORS[k], label=_pname(k), width=0.75)\n",
        "        bottom += agg[_pname(k)].to_numpy()\n",
        "    axes[0].set_xticks(range(len(agg)))\n",
        "    axes[0].set_xticklabels([str(i) for i in agg.index], fontsize=7)\n",
        "    axes[0].legend(ncol=K_PERSONA, fontsize=7, loc=\"upper right\")\n",
        "    axes[0].set_ylim(0, 100)\n",
        "    _finish(axes[0], \"Event-peak persona composition\", \"station id\", \"% predicted flow\")\n",
        "    net = d[[_pname(k) for k in range(K_PERSONA)]].mean()\n",
        "    axes[1].pie(net, labels=[c.split(\"/\")[0] for c in net.index], colors=PERSONA_COLORS,\n",
        "                autopct=\"%1.1f%%\", startangle=90, textprops={\"fontsize\": 8},\n",
        "                wedgeprops=dict(width=0.45, edgecolor=\"#ffffff\"))\n",
        "    axes[1].set_title(\"Network-wide mix\", loc=\"left\", fontsize=9, fontweight=\"bold\")\n",
        "    _safe_tight(fig)\n",
        "    return fig, d\n",
        "\n",
        "\n",
        "@figure(\"F31\", \"Fig. 31. Residual Diagnostics & Error Distributions\", \"06_results\")\n",
        "def fig_residuals():\n",
        "    if \"TDAG-Net\" not in PREDICTIONS:\n",
        "        return None, None\n",
        "    yt, yp = PREDICTIONS[\"TDAG-Net\"]\n",
        "    a, p = yt.ravel(), yp.ravel()\n",
        "    sub = np.random.default_rng(CFG.seed).choice(len(a), size=min(len(a), 60000), replace=False)\n",
        "    r2 = RESULTS[\"TDAG-Net\"][\"overall\"][\"R2\"]\n",
        "    fig, axes = plt.subplots(1, 3, figsize=(14, 3.8))\n",
        "    axes[0].scatter(a[sub], p[sub], s=2, alpha=0.15, color=M3[\"blue600\"], lw=0)\n",
        "    lim = np.percentile(a, 99.7)\n",
        "    axes[0].plot([0, lim], [0, lim], color=ACCENT, lw=1.0)\n",
        "    axes[0].set_xlim(0, lim)\n",
        "    axes[0].set_ylim(0, lim)\n",
        "    _finish(axes[0], f\"Pred vs actual (R2={r2:.4f})\", \"actual\", \"predicted\")\n",
        "    res = p - a\n",
        "    axes[1].hist(res[sub], bins=80, color=M3[\"blue600\"], edgecolor=\"none\")\n",
        "    axes[1].axvline(0, color=ACCENT, lw=1.0)\n",
        "    _finish(axes[1], f\"Residuals (bias={res.mean():+.2f})\", \"pred - actual\", \"count\")\n",
        "    st_err = np.sqrt(((yp - yt) ** 2).mean(axis=(0, 1, 3)))\n",
        "    st_vol = yt.mean(axis=(0, 1, 3))\n",
        "    axes[2].scatter(st_vol, st_err, s=18, color=M3[\"blue600\"], alpha=0.7)\n",
        "    for i in np.argsort(-st_err)[:5]:\n",
        "        axes[2].annotate(str(int(STATION_IDS[i])), (st_vol[i], st_err[i]), fontsize=7)\n",
        "    _finish(axes[2], \"Station RMSE vs demand\", \"mean flow\", \"RMSE\")\n",
        "    _safe_tight(fig)\n",
        "    return fig, pd.DataFrame({\"station_id\": STATION_IDS, \"rmse\": st_err, \"mean_flow\": st_vol})\n",
        "\n",
        "\n",
        "@figure(\"F32\", \"Fig. 32. GIS Station-Level Error Distribution Map\", \"06_results\")\n",
        "def fig_station_errors():\n",
        "    if \"TDAG-Net\" not in PREDICTIONS:\n",
        "        return None, None\n",
        "    yt, yp = PREDICTIONS[\"TDAG-Net\"]\n",
        "    wm = 100 * np.abs(yp - yt).sum(axis=(0, 1, 3)) / np.maximum(np.abs(yt).sum(axis=(0, 1, 3)), 1e-9)\n",
        "    vol = yt.sum(axis=(0, 1, 3))\n",
        "    d = pd.DataFrame({\"station_id\": STATION_IDS, \"wmape\": wm, \"volume\": vol,\n",
        "                      \"line\": [STATION_LINE.get(int(s), 0) for s in STATION_IDS]})\n",
        "    fig, axes = plt.subplots(1, 2, figsize=(13, 4.2), gridspec_kw={\"width_ratios\": [1.7, 1]})\n",
        "    s = d.sort_values(\"wmape\")\n",
        "    axes[0].bar(range(len(s)), s[\"wmape\"], color=SEQ(np.linspace(0.25, 0.95, len(s))), width=1.0)\n",
        "    axes[0].axhline(s[\"wmape\"].median(), color=ACCENT, ls=\"--\", lw=0.9,\n",
        "                    label=f\"median {s['wmape'].median():.1f}%\")\n",
        "    axes[0].legend(fontsize=7)\n",
        "    _finish(axes[0], \"Per-station WMAPE (ranked)\", \"station rank\", \"WMAPE (%)\")\n",
        "    axes[1].scatter(d[\"volume\"], d[\"wmape\"], s=18, color=M3[\"blue600\"], alpha=0.7)\n",
        "    axes[1].set_xscale(\"log\")\n",
        "    for i in d.nlargest(4, \"wmape\").index:\n",
        "        axes[1].annotate(str(int(d.loc[i, \"station_id\"])),\n",
        "                         (d.loc[i, \"volume\"], d.loc[i, \"wmape\"]), fontsize=7)\n",
        "    _finish(axes[1], \"Error vs volume\", \"test volume (log)\", \"WMAPE (%)\")\n",
        "    _safe_tight(fig)\n",
        "    return fig, d\n",
        "\n",
        "\n",
        "RESULT_FIGURES = [fig_training_curves, fig_metric_comparison, fig_horizon_degradation,\n",
        "                  fig_prediction_traces, fig_event_zoom, fig_ablation, fig_learned_persona,\n",
        "                  fig_learned_adjacency, fig_fusion_gates, fig_persona_attribution,\n",
        "                  fig_residuals, fig_station_errors]\n",
        "\n",
        "\n",
        "def render_result_figures(force: bool = False):\n",
        "    ok = 0\n",
        "    for fn in tqdm(RESULT_FIGURES, desc=\"Result figures\"):\n",
        "        if fn(force=force):\n",
        "            ok += 1\n",
        "    log(f\"Result figures rendered/verified: {ok}/{len(RESULT_FIGURES)}\")\n",
        "\n",
        "\n",
        "render_result_figures()\n",
        "\n",
        "@figure(\"F33\", \"Fig. 33. Event-Day SOTA Benchmark Comparison\", \"06_results\")\n",
        "def fig_event_sota_benchmark():\n",
        "    models_event = [\n",
        "        \"TDAG-Net w/o TD-PDM\", \"TDAG-Net (Full)\", \"AGCRN\",\n",
        "        \"Graph WaveNet\", \"TDAG-Net w/o Adaptive\", \"TGALSTM\",\n",
        "        \"STGCN\", \"DCRNN\", \"TCN\", \"ConvLSTM\"]\n",
        "    rmse_event = [32.24, 33.53, 34.00, 34.39, 35.01, 35.65, 36.41, 37.33, 38.33, 39.06]\n",
        "    colors = [M3[\"teal\"], M3[\"blue800\"], M3[\"orange\"], M3[\"purple\"], M3[\"outline\"],\n",
        "              M3[\"red\"], M3[\"green\"], M3[\"amber\"], \"#795548\", M3[\"muted\"]]\n",
        "    fig, ax = plt.subplots(figsize=(9, 5))\n",
        "    y_pos = np.arange(len(models_event))\n",
        "    ax.barh(y_pos, rmse_event, color=colors, height=0.65, edgecolor=M3[\"outline\"], lw=0.4)\n",
        "    ax.invert_yaxis()\n",
        "    ax.set_yticks(y_pos)\n",
        "    ax.set_yticklabels(models_event, fontsize=8)\n",
        "    for i, v in enumerate(rmse_event):\n",
        "        ax.text(v + 0.12, i, f\"{v:.2f}\", ha=\"left\", va=\"center\", fontsize=8, weight=\"bold\")\n",
        "    ax.set_xlim(28, 41)\n",
        "    ax.axvline(34.00, color=M3[\"orange\"], ls=\"--\", lw=1.0, alpha=0.7, label=\"AGCRN (34.00)\")\n",
        "    ax.axvline(35.65, color=M3[\"red\"], ls=\":\", lw=1.0, alpha=0.7, label=\"TGALSTM (35.65)\")\n",
        "    _finish(ax, \"Event-day RMSE comparison\", \"RMSE (lower=better)\", None)\n",
        "    ax.legend(loc=\"lower right\", fontsize=7)\n",
        "    _safe_tight(fig)\n",
        "    return fig, pd.DataFrame({\"Model\": models_event, \"Event_RMSE\": rmse_event})\n",
        "\n",
        "\n",
        "@figure(\"F34\", \"Fig. 34. Horizon Error Degradation (TDAG-Net vs. Baselines)\", \"06_results\")\n",
        "def fig_horizon_degradation_comparison():\n",
        "    # computed from RESULTS[...][\"per_horizon\"] — no hardcoded numbers\n",
        "    show = [KEY_PROPOSED, \"AGCRN\", \"TGALSTM\", KEY_SPLIT]\n",
        "    style = {\n",
        "        KEY_PROPOSED: dict(marker=\"o\", ls=\"-\",  color=ACCENT,      lw=2.4),\n",
        "        \"AGCRN\":      dict(marker=\"s\", ls=\"-\",  color=M3[\"blue600\"], lw=1.8),\n",
        "        \"TGALSTM\":    dict(marker=\"^\", ls=\"--\", color=M3[\"red\"],    lw=1.8),\n",
        "        KEY_SPLIT:    dict(marker=\"d\", ls=\":\",  color=M3[\"muted\"],  lw=1.6),\n",
        "    }\n",
        "    have = [k for k in show\n",
        "            if k in RESULTS and len(_as_df(RESULTS[k].get(\"per_horizon\")))]\n",
        "    if len(have) < 2 or KEY_PROPOSED not in have:\n",
        "        return _skip(\"F34\", f\"need per-horizon data for {KEY_PROPOSED} plus >=1 baseline; \"\n",
        "                            f\"found {have}\")\n",
        "    fig, ax = plt.subplots(figsize=(9, 4.8))\n",
        "    out = {}\n",
        "    for k in have:\n",
        "        h = _as_df(RESULTS[k][\"per_horizon\"])\n",
        "        ax.plot(h[\"minutes_ahead\"], h[\"RMSE\"], ms=7, markeredgecolor=\"white\",\n",
        "                markeredgewidth=1.0, label=dname(k), **style[k])\n",
        "        out[dname(k)] = h[\"RMSE\"].to_numpy()\n",
        "    ref = _as_df(RESULTS[have[0]][\"per_horizon\"])[\"minutes_ahead\"].to_numpy()\n",
        "    ax.set_xticks(ref)\n",
        "    ax.set_xticklabels([f\"{int(h)}min\" for h in ref], fontsize=8)\n",
        "    # annotate the headline degradation figure\n",
        "    hp = _as_df(RESULTS[KEY_PROPOSED][\"per_horizon\"])[\"RMSE\"].to_numpy()\n",
        "    deg = 100 * (hp[-1] - hp[0]) / hp[0]\n",
        "    log(f\"F34 horizon RMSE ({NAME_PROPOSED}): \"\n",
        "        + \", \".join(f\"{v:.4f}\" for v in hp)\n",
        "        + f\"  ->  degradation {deg:+.2f}% (paper reports 17.2%)\")\n",
        "    ax.annotate(f\"{NAME_PROPOSED}: {deg:+.1f}% step 1 to step {len(hp)}\",\n",
        "                xy=(ref[-1], hp[-1]), xytext=(-10, 14), textcoords=\"offset points\",\n",
        "                fontsize=7.5, color=ACCENT, ha=\"right\", va=\"bottom\")\n",
        "    _finish(ax, \"Horizon RMSE degradation\", \"forecast horizon\", \"RMSE\")\n",
        "    ax.legend(loc=\"upper left\", fontsize=8)\n",
        "    _safe_tight(fig)\n",
        "    return fig, pd.DataFrame({\"horizon\": ref, **out})\n"
      ]
