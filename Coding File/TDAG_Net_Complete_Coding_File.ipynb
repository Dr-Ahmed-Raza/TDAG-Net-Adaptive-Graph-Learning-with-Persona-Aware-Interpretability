        "import seaborn as sns\n",
        "\n",
        "# ── M3 Colour Tokens ─────────────────────────────────────────────────────────\n",
        "M3 = {\n",
        "    \"blue600\": \"#1a73e8\", \"blue800\": \"#185abc\", \"blue900\": \"#174ea6\",\n",
        "    \"blue100\": \"#d2e3fc\", \"blue50\": \"#e8f0fe\",\n",
        "    \"orange\": \"#e8710a\", \"green\": \"#0d652d\", \"purple\": \"#9334e6\",\n",
        "    \"teal\": \"#009688\", \"red\": \"#d93025\", \"amber\": \"#f9ab00\",\n",
        "    \"ink\": \"#1f1f1f\", \"muted\": \"#49454f\",\n",
        "    \"outline\": \"#cac4d0\", \"surface\": \"#f0f0f0\",\n",
        "}\n",
        "\n",
        "PERSONA_COLORS = [M3[\"blue800\"], M3[\"orange\"], M3[\"green\"], M3[\"purple\"]]\n",
        "ACCENT  = M3[\"orange\"]\n",
        "INK     = M3[\"ink\"]\n",
        "MUTED   = M3[\"muted\"]\n",
        "\n",
        "SEQ = LinearSegmentedColormap.from_list(\"m3s\", [\n",
        "    \"#ffffff\", M3[\"blue50\"], M3[\"blue100\"], \"#aecbfa\",\n",
        "    \"#669df6\", M3[\"blue600\"], M3[\"blue800\"], M3[\"blue900\"], \"#0d2137\"])\n",
        "DIV = LinearSegmentedColormap.from_list(\"m3d\", [\n",
        "    M3[\"blue900\"], \"#669df6\", M3[\"blue50\"], \"#fafafa\",\n",
        "    \"#fef0e1\", M3[\"amber\"], M3[\"orange\"], \"#bf360c\"])\n",
        "\n",
        "mpl.rcParams.update({\n",
        "    \"figure.dpi\": 150, \"savefig.dpi\": 300,\n",
        "    \"savefig.bbox\": \"tight\", \"savefig.pad_inches\": 0.15,\n",
        "    \"font.family\": \"sans-serif\",\n",
        "    \"font.sans-serif\": [\"Roboto\", \"DejaVu Sans\", \"Arial\"],\n",
        "    \"font.size\": 9,\n",
        "    \"axes.titlesize\": 10, \"axes.titleweight\": \"bold\", \"axes.titlepad\": 8,\n",
        "    \"axes.labelsize\": 9, \"axes.labelweight\": \"bold\", \"axes.labelpad\": 6,\n",
        "    \"axes.spines.top\": False, \"axes.spines.right\": False,\n",
        "    \"axes.edgecolor\": M3[\"outline\"], \"axes.linewidth\": 0.7,\n",
        "    \"axes.facecolor\": \"#ffffff\",\n",
        "    \"axes.grid\": True,\n",
        "    \"grid.color\": M3[\"surface\"], \"grid.linestyle\": \"-\",\n",
        "    \"grid.linewidth\": 0.5, \"grid.alpha\": 0.7,\n",
        "    \"legend.frameon\": True, \"legend.facecolor\": \"#ffffff\",\n",
        "    \"legend.edgecolor\": M3[\"outline\"], \"legend.framealpha\": 0.92,\n",
        "    \"legend.fontsize\": 8, \"legend.borderpad\": 0.5,\n",
        "    \"xtick.labelsize\": 8, \"ytick.labelsize\": 8,\n",
        "    \"xtick.direction\": \"out\", \"ytick.direction\": \"out\",\n",
        "    \"xtick.color\": M3[\"muted\"], \"ytick.color\": M3[\"muted\"],\n",
        "    \"figure.facecolor\": \"#ffffff\",\n",
        "    \"lines.linewidth\": 1.8, \"lines.markersize\": 5,\n",
        "    \"patch.linewidth\": 0.5,\n",
        "})\n",
        "\n",
        "def _pname(k):\n",
        "    return CFG.persona_names[k]\n",
        "\n",
        "def _finish(ax, title=None, xlabel=None, ylabel=None):\n",
        "    \"\"\"Clean axis styling — short titles only.\"\"\"\n",
        "    if title:\n",
        "        ax.set_title(title, loc=\"left\", fontsize=10, fontweight=\"bold\",\n",
        "                     color=INK, pad=8)\n",
        "    if xlabel:\n",
        "        ax.set_xlabel(xlabel, fontsize=9, fontweight=\"bold\", color=MUTED)\n",
        "    if ylabel:\n",
        "        ax.set_ylabel(ylabel, fontsize=9, fontweight=\"bold\", color=MUTED)\n",
        "    ax.tick_params(labelsize=8, length=3, width=0.5, colors=MUTED)\n",
        "    return ax\n",
        "\n",
        "def _heatmap_annot(ax, data, fmt=\".2f\", fs=6):\n",
        "    \"\"\"Annotate heatmap cells — only call for small matrices.\"\"\"\n",
        "    nr, nc = data.shape\n",
        "    mid = (data.max() + data.min()) / 2.0\n",
        "    for i in range(nr):\n",
        "        for j in range(nc):\n",
        "            v = data[i, j]\n",
        "            c = \"#ffffff\" if v > mid else INK\n",
        "            ax.text(j, i, f\"{v:{fmt}}\", ha=\"center\", va=\"center\",\n",
        "                    color=c, fontsize=fs, fontweight=\"bold\")\n",
        "\n",
        "def _safe_tight(fig, has_suptitle=False):\n",
        "    \"\"\"Apply tight_layout with proper margins.\"\"\"\n",
        "    fig.tight_layout(pad=1.2, w_pad=1.0, h_pad=1.0)\n",
        "    if has_suptitle:\n",
        "        fig.subplots_adjust(top=0.91)\n",
        "\n",
        "log(\"M3 plot style configured.\")\n"
