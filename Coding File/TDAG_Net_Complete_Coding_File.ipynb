        "Defines the individual PyTorch modules for TDPDM, Enhanced TCN, and PCHGAT components."
      ]
    },
    {
      "cell_type": "code",
      "execution_count": 31,
      "id": "46fa9990",
      "metadata": {
        "id": "46fa9990"
      },
      "outputs": [],
      "source": [
        "# ═══════════════════════════════════════════════════════════════════════════════\n",
        "# [25] TDAG-NET — full model\n",
        "# ═══════════════════════════════════════════════════════════════════════════════\n",
        "\n",
        "class TDAGNet(nn.Module):\n",
        "    def __init__(self, n_nodes, n_card, K, dz, dn, horizon, cfg=CFG,\n",
        "                 prior=None, init_adj=None, topo=None,\n",
        "                 use_tdpdm=True, use_pchgat=True, use_ecaam=True, use_adaptive=True):\n",
        "        super().__init__()\n",
        "        self.K = K if use_tdpdm else 1\n",
        "        self.use_tdpdm, self.use_pchgat = use_tdpdm, use_pchgat\n",
        "        self.use_ecaam, self.use_adaptive = use_ecaam, use_adaptive\n",
        "        ch = cfg.tcn_channels\n",
        "        hid = cfg.hidden_dim\n",
        "\n",
        "        self.tdpdm = TDPDM(n_card, K, prior) if use_tdpdm else None\n",
        "        self.in_proj = nn.Linear(2 + dn, ch)                    # in/out flow ⊕ node exogenous\n",
        "        self.tcn = EnhancedTCN(ch, ch, cfg.tcn_dilations, dropout=cfg.dropout)\n",
        "\n",
        "        adj0 = None\n",
        "        if init_adj is not None:\n",
        "            adj0 = init_adj if use_tdpdm else init_adj.mean(0, keepdim=True)\n",
        "        self.pchgat = PCHGAT(ch, hid, self.K, n_nodes, dz, cfg.gat_heads,\n",
        "                             cfg.node_emb_dim, adj0, cfg.gat_dropout)\n",
        "        # topology branch (TGALSTM's fixed-graput)\T, retained as a parallel view)\n",
        "        self.topo_gat = DenseGAT(ch, hid, cfg.gat_heads, cfg.gat_dropout)\n",
        "        self.register_buffer(\"A_topo\", topo if topo is not None else torch.eye(n_nodes))\n",
        "\n",
        "        self.fuse_w = nn.Parameter(torch.ones(3))               # weighted feature fusion\n",
        "        self.decoder = AttentionLSTMDecoder(ch + hid + hid, cfg.lstm_hidden, horizon,\n",
        "                                            2, cfg.dropout)\n",
        "\n",
        "    def forward(self, batch, return_aux=False):\n",
        "        x_tot = batch[\"x_total\"]                                # [B,L,N,2]\n",
        "        znode = batch[\"znode\"]                                  # [B,L,N,dn]\n",
        "        z_last = batch[\"z\"][:, -1]                              # [B,dz]\n",
        "        B, Lx, N, _ = x_tot.shape\n",
        "\n",
        "        if self.use_tdpdm:\n",
        "            xp, P = self.tdpdm(batch[\"x_card\"], batch[\"event\"])  # [B,L,N,2,K]\n",
        "        else:\n",
        "            xp = x_tot.unsqueeze(-1)                             # [B,L,N,2,1]\n",
        "            P = None\n",
        "        K = xp.shape[-1]\n",
        "\n",
        "        # ── per-persona temporal encoding (shared TCN weights across personas) ──\n",
        "        h = torch.cat([xp.permute(0, 1, 2, 4, 3).reshape(B, Lx, N, K, 2),\n",
        "                       znode.unsqueeze(3).expand(-1, -1, -1, K, -1)], dim=-1)   # [B,L,N,K,2+dn]\n",
        "        h = self.in_proj(h)                                                     # [B,L,N,K,ch]\n",
        "        hh = h.permute(0, 2, 3, 4, 1).reshape(B * N * K, -1, Lx)                # [B*N*K, ch, L]\n",
        "        hh = self.tcn(hh)\n",
        "        h = hh.view(B, N, K, -1, Lx).permute(0, 4, 1, 2, 3)                     # [B,L,N,K,ch]\n",
        "\n",
        "        # ── spatial: persona-conditioned branch + fixed-topology branch ─────────\n",
        "        g_p, aux = self.pchgat(h, z_last, M_VENUE_t,\n",
        "                               use_adaptive=self.use_adaptive,\n",
        "                               use_ecaam=self.use_ecaam,\n",
        "                               share_adj=not self.use_pchgat)                   # [B,L,N,hid]\n",
        "        h_mean = h.mean(dim=3)                                                  # [B,L,N,ch]\n",
        "        g_t, _ = self.topo_gat(h_mean, h_mean.mean(1), self.A_topo)             # [B,L,N,hid]\n",
        "\n",
        "        w = torch.softmax(self.fuse_w, dim=0)\n",
        "        fused = torch.cat([w[0] * h_mean, w[1] * g_p, w[2] * g_t], dim=-1)      # [B,L,N,·]\n",
        "\n",
        "        y, attn_t = self.decoder(fused.permute(0, 2, 1, 3))                     # [B,H,N,2]\n",
        "        if return_aux:\n",
        "            aux.update({\"P\": P, \"fusion_w\": w.detach(), \"temporal_attn\": attn_t.detach(),\n",
        "                        \"alpha\": (Fn.softplus(self.tdpdm.alpha).detach()\n",
        "                                  if self.tdpdm is not None else None),\n",
        "                        \"gamma\": Fn.softplus(self.pchgat.ecaam.gamma).detach(),\n",
        "                        \"persona_channels\": xp.detach()})\n",
        "            return y, aux\n",
        "        return y\n",
        "\n",
        "    def aux_loss(self):\n",
        "        if self.tdpdm is None:\n",
        "            return torch.zeros((), device=next(self.parameters()).device), \\\n",
        "                   torch.zeros((), device=next(self.parameters()).device)\n",
        "        return self.tdpdm.aux_loss()"
      ]
    },
