        "# ═══════════════════════════════════════════════════════════════════════════════\n",
        "# [28] MODEL REGISTRY — every experiment in the paper, in one table\n",
        "# ═══════════════════════════════════════════════════════════════════════════════\n",
        "\n",
        "def build_model(name: str) -> nn.Module:\n",
        "    n, hz = N_STATIONS, H\n",
        "    common = dict(n_nodes=n, horizon=hz)\n",
        "    tdag = dict(n_nodes=n, n_card=N_CARD, K=K_PERSONA, dz=DZ, dn=DN, horizon=hz,\n",
        "                prior=PRIOR_t, init_adj=A_PER_t, topo=A_TOPO_t)\n",
        "\n",
        "    table = {\n",
        "        # ── proposed ────────────────────────────────────────────────────────\n",
        "        \"TDAG-Net\":            lambda: TDAGNet(**tdag),\n",
        "        # ── ablations (same code path, flags flipped) ───────────────────────\n",
        "        \"TDAG-Net w/o TD-PDM\": lambda: TDAGNet(**tdag, use_tdpdm=False),\n",
        "        \"TDAG-Net w/o PC-HGAT\": lambda: TDAGNet(**tdag, use_pchgat=False),\n",
        "        \"TDAG-Net w/o EC-AAM\": lambda: TDAGNet(**tdag, use_ecaam=False),\n",
        "        \"TDAG-Net w/o Adaptive\": lambda: TDAGNet(**tdag, use_adaptive=False),\n",
        "        # ── retained from TGALSTM ───────────────────────────────────────────\n",
        "        \"TCN\":       lambda: TCNBaseline(**common),\n",
        "        \"ConvLSTM\":  lambda: ConvLSTMBaseline(**common),\n",
        "        \"SVR-LSTM\":  lambda: SVRLSTMBaseline(**common),\n",
        "        \"LSTM\":      lambda: LSTMBaseline(**common),\n",
        "        # ── modern GNNs (new) ───────────────────────────────────────────────\n",
        "        \"STGCN\":         lambda: STGCN(adj=A_TOPO_t, **common),\n",
        "        \"DCRNN\":         lambda: DCRNN(adj=A_TOPO_t, **common),\n",
        "        \"Graph WaveNet\": lambda: GraphWaveNet(adj=A_TOPO_t, **common),\n",
        "        \"AGCRN\":         lambda: AGCRN(**common),\n",
        "        # ── direct predecessor ──────────────────────────────────────────────\n",
        "        \"TGALSTM\":   lambda: TGALSTM(topo=A_TOPO_t, **common),\n",
        "    }\n",
        "    if name not in table:\n",
        "        raise KeyError(f\"Unknown model '{name}'. Available: {list(table)}\")\n",
        "    return table[name]().to(DEVICE)\n",
        "\n",
        "\n",
        "MODEL_ORDER = [\"LSTM\", \"TCN\", \"ConvLSTM\", \"SVR-LSTM\", \"STGCN\", \"DCRNN\",\n",
