      "source": [
        "# ═══════════════════════════════════════════════════════════════════════════════\n",
        "# [26] BASELINES — part 1: non-graph (TGALSTM's original comparison set)\n",
        "# ═══════════════════════════════════════════════════════════════════════════════\n",
        "\n",
        "class _Base(nn.Module):\n",
        "    \"\"\"All baselines share the same signature: batch dict → [B, H, N, 2].\"\"\"\n",
        "\n",
        "    needs_card = False\n",
        "\n",
        "    def forward(self, batch, return_aux=False):\n",
        "        raise NotImplementedError\n",
        "\n",
        "\n",
        "class LSTMBaseline(_Base):\n",
        "    def __init__(self, n_nodes, horizon, hidden=128, **kw):\n",
        "        super().__init__()\n",
        "        self.lstm = nn.LSTM(2, hidden, num_layers=2, batch_first=True, dropout=0.1)\n",
        "        self.head = nn.Linear(hidden, horizon * 2)\n",
        "        self.horizon = horizon\n",
        "\n",
        "    def forward(self, batch, return_aux=False):\n",
        "        x = batch[\"x_total\"]\n",
        "        B, Lx, N, _ = x.shape\n",
        "        h, _ = self.lstm(x.permute(0, 2, 1, 3).reshape(B * N, Lx, 2))\n",
        "        y = self.head(h[:, -1]).view(B, N, self.horizon, 2).permute(0, 2, 1, 3)\n",
        "        return (y, {}) if return_aux else y\n",
        "\n",
        "\n",
        "class TCNBaseline(_Base):\n",
        "    def __init__(self, n_nodes, horizon, ch=64, **kw):\n",
        "        super().__init__()\n",
        "        self.b1 = EnhancedTCN(2, ch, CFG.tcn_dilations)\n",
        "        self.b2 = EnhancedTCN(ch, ch, CFG.tcn_dilations)\n",
        "        self.head = nn.Linear(ch, horizon * 2)\n",
        "        self.horizon = horizon\n",
        "\n",
        "    def forward(self, batch, return_aux=False):\n",
        "        x = batch[\"x_total\"]\n",
        "        B, Lx, N, _ = x.shape\n",
        "        h = x.permute(0, 2, 3, 1).reshape(B * N, 2, Lx)\n",
        "        h = self.b2(self.b1(h))[:, :, -1]\n",
        "        y = self.head(h).view(B, N, self.horizon, 2).permute(0, 2, 1, 3)\n",
        "        return (y, {}) if return_aux else y\n",
        "\n",
        "\n",
        "class ConvLSTMBaseline(_Base):\n",
        "    \"\"\"ConvLSTM over the station axis (stations ordered by line → 1-D 'space').\"\"\"\n",
        "\n",
        "    def __init__(self, n_nodes, horizon, hidden=64, k=3, **kw):\n",
        "        super().__init__()\n",
        "        self.hidden, self.k = hidden, k\n",
        "        self.conv = nn.Conv1d(2 + hidden, 4 * hidden, k, padding=k // 2)\n",
        "        self.head = nn.Conv1d(hidden, horizon * 2, 1)\n",
        "        self.horizon = horizon\n",
        "\n",
        "    def forward(self, batch, return_aux=False):\n",
        "        x = batch[\"x_total\"].permute(0, 1, 3, 2)                  # [B,L,2,N]\n",
        "        B, Lx, _, N = x.shape\n",
        "        h = torch.zeros(B, self.hidden, N, device=x.device, dtype=x.dtype)\n",
        "        c = torch.zeros_like(h)\n",
        "        for t in range(Lx):\n",
        "            z = self.conv(torch.cat([x[:, t], h], dim=1))\n",
        "            i, f, o, g = z.chunk(4, dim=1)\n",
        "            c = torch.sigmoid(f) * c + torch.sigmoid(i) * torch.tanh(g)\n",
        "            h = torch.sigmoid(o) * torch.tanh(c)\n",
        "        y = self.head(h).view(B, self.horizon, 2, N).permute(0, 1, 3, 2)\n",
        "        return (y, {}) if return_aux else y\n",
        "\n",
        "\n",
        "class SVRLSTMBaseline(_Base):\n",
        "    \"\"\"SVR-LSTM hybrid — see docstring below for the documented scalability adaptation.\"\"\"\n",
        "    \"\"\"\n",
        "    SVR-LSTM (TGALSTM's retained hybrid). Faithful in spirit, tractable at 191 stations:\n",
        "    a Nystroem RBF feature map + linear SVR is fitted on the training windows and its\n",
        "    prediction is fed to the LSTM as an auxiliary channel. Deviation documented in the paper.\n",
        "    \"\"\"\n",
        "\n",
        "    def __init__(self, n_nodes, horizon, hidden=128, **kw):\n",
        "        super().__init__()\n",
        "        self.lstm = nn.LSTM(3, hidden, batch_first=True)\n",
        "        self.head = nn.Linear(hidden, horizon * 2)\n",
        "        self.horizon = horizon\n",
        "        self.svr = None\n",
        "        self.nys = None\n",
        "\n",
        "    def fit_svr(self, idx, max_samples=20000):\n",
        "        from sklearn.kernel_approximation import Nystroem\n",
        "        from sklearn.svm import LinearSVR\n",
        "\n",
        "        rng = np.random.default_rng(CFG.seed)\n",
        "        sub = rng.choice(idx, size=min(len(idx), 400), replace=False)\n",
        "        Xs, ys = [], []\n",
        "        for s in sub:\n",
        "            b = gather(np.array([s]), need_card=False)\n",
        "            xt = b[\"x_total\"][0].detach().cpu().numpy()            # [L,N,2]\n",
        "            yt = b[\"y\"][0].detach().cpu().numpy()                  # [H,N,2]\n",
        "            Xs.append(xt.transpose(1, 0, 2).reshape(N_STATIONS, -1))\n",
        "            ys.append(yt[0].reshape(N_STATIONS, -1)[:, 0])\n",
        "        Xs = np.concatenate(Xs)\n",
        "        ys = np.concatenate(ys)\n",
        "        sel = rng.choice(len(Xs), size=min(len(Xs), max_samples), replace=False)\n",
        "        self.nys = Nystroem(gamma=0.05, n_components=120, random_state=CFG.seed).fit(Xs[sel])\n",
        "        self.svr = LinearSVR(C=1.0, max_iter=3000, random_state=CFG.seed).fit(\n",
        "            self.nys.transform(Xs[sel]), ys[sel])\n",
        "        log(f\"    SVR-LSTM: SVR fitted on {len(sel):,} station-windows\")\n",
        "\n",
        "    def _svr_channel(self, x):\n",
        "        B, Lx, N, _ = x.shape\n",
        "        if self.svr is None:\n",
        "            return torch.zeros(B, Lx, N, 1, device=x.device, dtype=x.dtype)\n",
        "        flat = x.permute(0, 2, 1, 3).reshape(B * N, Lx * 2).detach().cpu().numpy()\n",
        "        p = self.svr.predict(self.nys.transform(flat)).reshape(B, N, 1)\n",
        "        p = torch.from_numpy(p.astype(np.float32)).to(x.device)\n",
        "        return p.unsqueeze(1).expand(-1, Lx, -1, -1)\n",
        "\n",
        "    def forward(self, batch, return_aux=False):\n",
        "        x = batch[\"x_total\"]\n",
        "        B, Lx, N, _ = x.shape\n",
        "        s = self._svr_channel(x)\n",
        "        inp = torch.cat([x, s], dim=-1).permute(0, 2, 1, 3).reshape(B * N, Lx, 3)\n",
        "        h, _ = self.lstm(inp)\n",
        "        y = self.head(h[:, -1]).view(B, N, self.horizon, 2).permute(0, 2, 1, 3)\n",
        "        return (y, {}) if return_aux else y\n",
        "\n",
        "\n",
        "class TGALSTM(_Base):\n",
        "    \"\"\"The direct predecessor: enhanced TCN ⊕ single GAT on a fixed adjacency ⊕ Attention-LSTM.\"\"\"\n",
        "\n",
        "    def __init__(self, n_nodes, horizon, topo=None, ch=64, hid=64, **kw):\n",
        "        super().__init__()\n",
        "        self.in_proj = nn.Linear(2, ch)\n",
        "        self.tcn = EnhancedTCN(ch, ch, CFG.tcn_dilations)\n",
        "        self.gat = DenseGAT(ch, hid, CFG.gat_heads, CFG.gat_dropout)\n",
        "        self.register_buffer(\"A\", topo if topo is not None else torch.eye(n_nodes))\n",
        "        self.fuse = nn.Parameter(torch.ones(2))\n",
        "        self.dec = AttentionLSTMDecoder(ch + hid, CFG.lstm_hidden, horizon, 2)\n",
        "\n",
        "    def forward(self, batch, return_aux=False):\n",
        "        x = batch[\"x_total\"]\n",
        "        B, Lx, N, _ = x.shape\n",
        "        h = self.in_proj(x)\n",
        "        h = self.tcn(h.permute(0, 2, 3, 1).reshape(B * N, -1, Lx)).view(B, N, -1, Lx)\n",
        "        h = h.permute(0, 3, 1, 2)                                   # [B,L,N,ch]\n",
        "        g, _ = self.gat(h, h.mean(1), self.A)\n",
        "        w = torch.softmax(self.fuse, 0)\n",
        "        fused = torch.cat([w[0] * h, w[1] * g], dim=-1)\n",
        "        y, _ = self.dec(fused.permute(0, 2, 1, 3))\n",
        "        return (y, {}) if return_aux else y"
      ]
    },
