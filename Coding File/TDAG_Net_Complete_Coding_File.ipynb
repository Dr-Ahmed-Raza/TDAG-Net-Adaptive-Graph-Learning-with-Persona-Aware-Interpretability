        "\n",
        "@figure(\"F04\", \"Fig. 4. Ticket Code Pareto Volume Distribution\", \"01_corpus\")\n",
        "def fig_card_pareto():\n",
        "    d = CARD_FEATS.sort_values(\"share_pct\", ascending=False).reset_index(drop=True).copy()\n",
        "    d[\"cum_pct\"] = d[\"share_pct\"].cumsum()\n",
        "    fig, ax = plt.subplots(figsize=(12, 4.2))\n",
        "    colors = [PERSONA_COLORS[int(PERSONA_ASSIGN.set_index(\"label\")\n",
