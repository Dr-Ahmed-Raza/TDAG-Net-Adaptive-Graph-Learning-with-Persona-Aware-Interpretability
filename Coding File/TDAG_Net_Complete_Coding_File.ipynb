        "            h[\"model\"] = name\n",
        "            rows.append(h)\n",
        "    if not rows:\n",
        "        return None, None\n",
        "    hist = pd.concat(rows, ignore_index=True)\n",
        "    models = list(TRAINERS.keys())\n",
        "    ncol = 3\n",
        "    nrow = int(np.ceil(len(models) / ncol))\n",
        "    fig, axes = plt.subplots(nrow, ncol, figsize=(4.4 * ncol, 2.8 * nrow), squeeze=False)\n",
        "    for ax, name in zip(axes.ravel(), models):\n",
        "        h = hist[hist[\"model\"] == name]\n",
        "        ax.plot(h[\"epoch\"], h[\"train_loss\"], lw=1.3, color=M3[\"blue600\"], label=\"train\")\n",
        "        ax.plot(h[\"epoch\"], h[\"val_loss\"], lw=1.3, color=ACCENT, label=\"val\")\n",
        "        b = h.loc[h[\"val_loss\"].idxmin()] if len(h) else None\n",
        "        if b is not None:\n",
        "            ax.axvline(b[\"epoch\"], color=MUTED, ls=\"--\", lw=0.7)\n",
        "            ax.scatter([b[\"epoch\"]], [b[\"val_loss\"]], color=ACCENT, zorder=5, s=20)\n",
        "        for rp in TRAINERS[name].resume_points:\n",
        "            ax.axvline(rp[\"epoch\"], color=M3[\"green\"], ls=\":\", lw=0.9)\n",
        "        ax.set_title(name, fontsize=9, loc=\"left\", fontweight=\"bold\")\n",
        "        ax.set_xlabel(\"epoch\", fontsize=7)\n",
