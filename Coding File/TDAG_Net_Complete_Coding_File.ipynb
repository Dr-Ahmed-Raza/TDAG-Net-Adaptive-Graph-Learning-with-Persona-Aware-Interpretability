        "# ═══════════════════════════════════════════════════════════════════════════════\n",
        "# [35] PACKAGING — RESULTS_SUMMARY.md, asset manifest, zip bundle\n",
        "# ═══════════════════════════════════════════════════════════════════════════════\n",
        "def _md(df):\n",
        "    try:\n",
        "        return df.to_markdown(index=False, floatfmt=\".4f\")\n",
        "    except Exception:\n",
        "        return \"```\\n\" + df.to_string(index=False) + \"\\n```\"\n",
        "\n",
        "\n",
        "def build_summary() -> str:\n",
        "    lines = []\n",
        "    A = lines.append\n",
        "    A(f\"# TDAG-Net — Results Summary ({CFG.dataset} corpus)\\n\")\n",
        "    A(f\"_Generated {datetime.now().strftime('%Y-%m-%d %H:%M')} · \"\n",
        "      f\"device {DEVICE} · seed {CFG.seed}_\\n\")\n",
        "\n",
        "    A(\"\\n## 1. Dataset\\n\")\n",
        "    A(f\"| Property | Value |\\n|---|---|\")\n",
        "    A(f\"| Corpus | Nanjing Metro AFC {CFG.dataset} |\")\n",
        "    A(f\"| Source files ingested | {len(_audit)} |\")\n",
        "    A(f\"| Raw records read | {int(_audit['rows_read'].sum()):,} |\" if len(_audit) else \"\")\n",
        "    A(f\"| Records retained | {int(_audit['rows_kept'].sum()):,} |\" if len(_audit) else \"\")\n",
        "    A(f\"| Stations (after excluding {list(CFG.exclude_station_ids)}) | {N_STATIONS} |\")\n",
        "    A(f\"| Lines | {sorted(set(STATION_LINE.values())) if STATION_LINE else 'n/a'} |\")\n",
        "    A(f\"| Usable days | {N_DAYS} ({TENS['days'][0]} → {TENS['days'][-1]}) |\")\n",
        "    A(f\"| Interval | {CFG.freq_minutes} min, {CFG.service_start}–{CFG.service_end} |\")\n",
        "    A(f\"| Ticket channels | {N_CARD} (top {CFG.n_card_channels} + OTHER, \"\n",
        "      f\"{TENS['card_coverage'] * 100:.2f}% coverage) |\")\n",
        "    A(f\"| Transfer (type-4) share | {qc['transfer_share_pct']:.3f}% |\")\n",
        "    A(f\"| Windows (train/val/test) | {len(IDX_TR):,} / {len(IDX_VA):,} / {len(IDX_TE):,} |\")\n",
        "    A(f\"| Event days flagged | {len(EVENTS['event_days'])} \"\n",
        "      f\"({int(TEST_EVENT_MASK.sum())} test windows) |\")\n",
        "\n",
        "    A(\"\\n## 2. Personas discovered (TD-PDM prior)\\n\")\n",
        "    A(\"| k | Persona | Ridership share | Codes |\\n|---|---|---|---|\")\n",
        "    for k in range(K_PERSONA):\n",
        "        sub = PERSONA_ASSIGN[PERSONA_ASSIGN[\"persona_idx\"] == k]\n",
        "        A(f\"| {k} | {CFG.persona_names[k]} | {PERSONA['volume_share_pct'][k]:.1f}% | \"\n",
        "          f\"{len(sub)} |\")\n",
        "\n",
        "    A(\"\\n## 3. Architecture decision evidence\\n\")\n",
        "    A(f\"- Origin-graph vs destination-graph cosine (**Option A**): \"\n",
        "      f\"`{GRAPH['od_cosine']:.4f}`\")\n",
        "    A(f\"- Mean pairwise persona-graph cosine (**Option B**): \"\n",
        "      f\"`{GRAPH['pairs']['cosine'].mean():.4f}`\")\n",
        "    A(f\"- Verdict: persona views are \"\n",
        "      f\"{'MORE' if GRAPH['pairs']['cosine'].mean() < GRAPH['od_cosine'] else 'NOT more'} \"\n",
        "      f\"distinct than the O/D split.\")\n",
        "\n",
        "    A(\"\\n## 4. Main results (test set)\\n\")\n",
        "    if len(TBL_MAIN):\n",
        "        A(_md(TBL_MAIN))\n",
        "    if len(TBL_EVENT):\n",
        "        A(\"\\n### Event days only\\n\")\n",
        "        A(_md(TBL_EVENT))\n",
        "\n",
        "    A(\"\\n## 5. Training configuration (fully tabulated — TGALSTM did not report δ)\\n\")\n",
        "    A(\"| Hyper-parameter | Value |\\n|---|---|\")\n",
        "    for k in [\"seq_len\", \"horizon\", \"batch_size\", \"epochs\", \"lr\", \"weight_decay\",\n",
        "              \"huber_delta\", \"grad_clip\", \"hidden_dim\", \"tcn_channels\", \"tcn_dilations\",\n",
        "              \"gat_heads\", \"gat_dropout\", \"lstm_hidden\", \"dropout\", \"node_emb_dim\",\n",
        "              \"n_personas\", \"n_card_channels\", \"adj_topk\", \"corr_min\",\n",
        "              \"venue_radius_km\", \"early_stop_patience\", \"seed\"]:\n",
        "        A(f\"| `{k}` | {getattr(CFG, k)} |\")\n",
        "\n",
        "    if INTERP:\n",
        "        A(\"\\n## 6. Interpretability\\n\")\n",
        "        if \"alpha_event_volatility\" in INTERP:\n",
        "            A(\"| Persona | α (event volatility) | γ (EC-AAM strength) |\\n|---|---|---|\")\n",
        "            for k in range(K_PERSONA):\n",
        "                g = INTERP[\"gamma_ecaam\"][k] if k < len(INTERP[\"gamma_ecaam\"]) else float(\"nan\")\n",
        "                A(f\"| {CFG.persona_names[k]} | {INTERP['alpha_event_volatility'][k]:.4f} | {g:.4f} |\")\n",
        "        A(f\"\\n- Soft-assignment drift ‖P* − P₀‖₁/CK = \"\n",
        "          f\"`{INTERP.get('persona_assignment_drift', float('nan')):.4f}`\")\n",
        "        A(f\"- Weighted fusion (temporal / persona-graph / topology): \"\n",
        "          f\"`{np.round(INTERP.get('fusion_weights', []), 3).tolist()}`\")\n",
        "\n",
        "    A(\"\\n## 7. Reproduction\\n\")\n",
        "    A(\"1. Open the notebook in Colab and mount the same Drive.\\n\"\n",
        "      \"2. `Runtime ▸ Run all`. Cached stages are skipped; training resumes from \"\n",
        "      \"`runs/*/checkpoints/last.pt`.\\n\"\n",
        "      \"3. To force a stage: `CFG.force_recompute = ('stage_name',)`.\\n\")\n",
        "    A(\"\\n## 8. Outstanding manual inputs\\n\")\n",
        "    A(f\"- `data/metadata/station_metadata.csv` — coordinates: \"\n",
        "      f\"**{'supplied' if HAS_COORDS else 'NOT supplied (topology is inferred from travel times)'}**\")\n",
        "    A(f\"- `data/metadata/event_venues.csv` — C_venue method: **{VENUE['method']}**\")\n",
        "    A(f\"- `data/metadata/event_calendar.csv` — {len(EVENTS['curated'])} curated rows; \"\n",
        "      f\"{len(EVENTS['candidates'])} auto-detected candidates await verification \"\n",
        "      f\"(`DETECTED_event_candidates_{CFG.dataset}.csv`)\")\n",
        "    A(f\"- `data/metadata/weather.csv` — \"\n",
        "      f\"{'supplied' if EXO['has_weather'] else 'not supplied (optional)'}\")\n",
        "    return \"\\n\".join([l for l in lines if l != \"\"])\n",
        "\n",
        "\n",
        "_summary = build_summary()\n",
        "with atomic_path(f\"{P['exports']}/RESULTS_SUMMARY_{CFG.dataset}.md\") as _tmp:\n",
        "    with open(_tmp, \"w\", encoding=\"utf-8\") as f:\n",
        "        f.write(_summary)\n",
        "print(_summary[:2600])\n",
        "print(\"\\n… full summary written to exports/\")\n",
        "\n",
        "# ── asset manifest + zip ─────────────────────────────────────────────────────\n",
        "_assets = []\n",
        "for _root, _dirs, _files in os.walk(P[\"root\"]):\n",
        "    if \"/cache/agg\" in _root.replace(\"\\\\\", \"/\"):\n",
        "        continue\n",
        "    for _f in _files:\n",
        "        _p = os.path.join(_root, _f)\n",
        "        if _f.endswith((\".pt\", \".tmp\")) and \"checkpoints\" in _root:\n",
        "            continue\n",
        "        with contextlib.suppress(OSError):\n",
        "            _assets.append({\"path\": os.path.relpath(_p, P[\"root\"]),\n",
        "                            \"size_kb\": round(os.path.getsize(_p) / 1024, 1),\n",
        "                            \"type\": os.path.splitext(_f)[1]})\n",
        "ASSETS = pd.DataFrame(_assets).sort_values(\"path\")\n",
        "save_df(ASSETS, f\"{P['exports']}/asset_manifest_{CFG.dataset}.csv\")\n",
        "print(f\"\\nAssets catalogued: {len(ASSETS)} files, \"\n",
        "      f\"{ASSETS['size_kb'].sum() / 1024:.1f} MB (checkpoints excluded)\")\n",
        "print(ASSETS.groupby(\"type\")[\"size_kb\"].agg([\"count\", \"sum\"]).sort_values(\"sum\", ascending=False)\n",
        "      .head(12).to_string())\n",
        "\n",
        "_bundle = f\"{P['exports']}/TDAGNet_paper_bundle_{CFG.dataset}\"\n",
        "try:\n",
        "    _stage_dir = f\"/tmp/tdag_bundle_{CFG.dataset}\"\n",
        "    shutil.rmtree(_stage_dir, ignore_errors=True)\n",
        "    for _sub in [\"figures\", \"results\", \"exports\", \"data\"]:\n",
        "        _src = f\"{P['root']}/{_sub}\"\n",
        "        if os.path.exists(_src):\n",
        "            shutil.copytree(_src, f\"{_stage_dir}/{_sub}\", dirs_exist_ok=True)\n",
        "    for _f in [\"config_active.json\", \"pipeline_state.json\"]:\n",
        "        if os.path.exists(f\"{P['root']}/{_f}\"):\n",
        "            shutil.copy(f\"{P['root']}/{_f}\", _stage_dir)\n",
        "    shutil.make_archive(_bundle, \"zip\", _stage_dir)\n",
        "    shutil.rmtree(_stage_dir, ignore_errors=True)\n",
        "    print(f\"\\n📦 Paper bundle → {_bundle}.zip \"\n",
        "          f\"({os.path.getsize(_bundle + '.zip') / 1e6:.1f} MB)\")\n",
        "except Exception as _exc:\n",
        "    log(f\"Bundle failed: {_exc}\", \"warning\")\n",
        "\n",
        "state_set(\"pipeline_complete\", True)\n",
        "log(\"PIPELINE COMPLETE.\")"
