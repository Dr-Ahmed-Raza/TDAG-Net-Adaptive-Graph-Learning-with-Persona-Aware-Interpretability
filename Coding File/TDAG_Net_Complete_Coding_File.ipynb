        "\n",
        "@figure(\"F07\", \"Fig. 7. PCA Mapping of Passenger Personas in Feature Space\", \"02_persona\")\n",
        "def fig_persona_space():\n",
        "    Z = PERSONA[\"Z\"]\n",
        "    if Z.shape[0] < 3:\n",
        "        return None, None\n",
        "    p = PCA(n_components=2, random_state=CFG.seed)\n",
        "    XY = p.fit_transform(Z)\n",
        "    vol = CARD_FEATS[\"volume\"].to_numpy(dtype=float)\n",
        "    size = 40 + 800 * (vol / max(vol.max(), 1)) ** 0.45\n",
        "    fig, ax = plt.subplots(figsize=(8, 6))\n",
        "    for k in range(K_PERSONA):\n",
        "        m = PERSONA_ASSIGN[\"persona_idx\"].to_numpy() == k\n",
        "        ax.scatter(XY[m, 0], XY[m, 1], s=size[m], color=PERSONA_COLORS[k],\n",
        "                   alpha=0.7, edgecolor=\"#fff\", lw=0.8, label=_pname(k), zorder=3)\n",
        "    for i, lab in enumerate(CARD_FEATS[\"label\"]):\n",
        "        if CARD_FEATS[\"share_pct\"].iloc[i] > 1.0:\n",
        "            ax.annotate(lab.replace(\"card_\", \"\"), (XY[i, 0], XY[i, 1]),\n",
        "                        fontsize=7, ha=\"center\", va=\"center\", color=\"white\",\n",
        "                        weight=\"bold\", zorder=4)\n",
        "    ax.legend(loc=\"best\", markerscale=0.4, fontsize=8)\n",
        "    _finish(ax, \"Persona clusters in PCA space\",\n",
        "            f\"PC1 ({p.explained_variance_ratio_[0]*100:.0f}%)\",\n",
        "            f\"PC2 ({p.explained_variance_ratio_[1]*100:.0f}%)\")\n",
        "    _safe_tight(fig)\n",
        "    d = pd.DataFrame({\"label\": CARD_FEATS[\"label\"], \"pc1\": XY[:, 0], \"pc2\": XY[:, 1],\n",
        "                      \"persona\": PERSONA_ASSIGN[\"persona\"], \"volume\": vol})\n",
        "    return fig, d\n",
        "\n",
        "\n",
        "@figure(\"F08\", \"Fig. 8. Diurnal Persona Profiles (Weekday vs. Weekend)\", \"02_persona\")\n",
        "def fig_persona_profiles():\n",
        "    prof = X_persona.sum(axis=(1, 2)).reshape(N_DAYS, BINS_PER_DAY, K_PERSONA)\n",
        "    wd = prof[~IS_WEEKEND_DAY].mean(axis=0) if (~IS_WEEKEND_DAY).any() else np.zeros((BINS_PER_DAY, K_PERSONA))\n",
        "    we = prof[IS_WEEKEND_DAY].mean(axis=0) if IS_WEEKEND_DAY.any() else np.zeros((BINS_PER_DAY, K_PERSONA))\n",
        "    hours = HOUR_OF_BIN[:BINS_PER_DAY]\n",
        "    fig, axes = plt.subplots(1, K_PERSONA, figsize=(14, 3.2), sharex=True)\n",
        "    for k in range(K_PERSONA):\n",
        "        ax = axes[k]\n",
        "        ax.fill_between(hours, wd[:, k] / 1e3, color=PERSONA_COLORS[k], alpha=0.25, label=\"weekday\")\n",
        "        ax.plot(hours, wd[:, k] / 1e3, color=PERSONA_COLORS[k], lw=1.6)\n",
        "        ax.plot(hours, we[:, k] / 1e3, color=INK, lw=1.2, ls=\"--\", label=\"weekend\")\n",
        "        wr = we[:, k].sum() / max(wd[:, k].sum(), 1e-9)\n",
        "        _finish(ax, f\"{_pname(k)} (w/w={wr:.2f})\", \"hour\",\n",
        "                \"k taps/10min\" if k == 0 else None)\n",
        "        ax.set_xticks([6, 9, 12, 15, 18, 21])\n",
        "        if k == 0:\n",
        "            ax.legend(loc=\"upper left\", fontsize=7)\n",
        "    _safe_tight(fig)\n",
        "    d = pd.DataFrame(np.hstack([wd, we]),\n",
        "                     columns=[f\"weekday_{_pname(k)}\" for k in range(K_PERSONA)] +\n",
        "                             [f\"weekend_{_pname(k)}\" for k in range(K_PERSONA)])\n",
        "    d.insert(0, \"hour\", hours)\n",
        "    return fig, d\n",
        "\n",
        "\n",
        "@figure(\"F09\", \"Fig. 9. TD-PDM Soft-Assignment Prior Matrix P0\", \"02_persona\")\n",
        "def fig_prior_matrix():\n",
        "    order = np.argsort(-CARD_FEATS[\"share_pct\"].to_numpy())\n",
